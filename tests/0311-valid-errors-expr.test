-q -v
----------------------------------------------------------------------
var I: Integer; B: Boolean; S: string[10]; R: Real; Rc: record X: Integer end;
function F(X: Integer): Integer; begin F := X end;
procedure P(var V: Integer); begin end;
begin
  I := 'abc';
  B := I + 1;
  I := Q;
  I := F;
  I := F(1, 2);
  P(5);
  P(R);
  I := R;
  S := I;
  R := I div R;
  B := not S;
  I := Rc.Y;
  I := I^;
  I := B[1];
  I := 1 + P(I);
  I := Integer(1.5);
  B := S = I;
  I := Length(I);
  I := Ord(1.5);
  Chain(S);
  I := Port[1];
  Write(I:5:2);
  Write(Rc);
  I := Abs(I, 1)
end.
