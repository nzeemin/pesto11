OPTIONS = -q
=== SOURCE ============================================================
type P = record X, Y: Real end;
var A, B: Real; I: Integer; Q: P; V: array[1..4] of Real;
function F(X: Real; var Y: Real): Real;
begin
  Y := X * 2;
  F := Y + 0.5
end;
begin
  A := 1.5;
  B := A * I - 2;
  Q.Y := F(B, Q.X);
  V[I] := -Q.Y;
  if A < B then I := Round(A) else I := Trunc(B / 3);
  WriteLn(A:8:2, Sqrt(B))
end.
