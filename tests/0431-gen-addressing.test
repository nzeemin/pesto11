=== SOURCE ============================================================
type
  Rec = record A: Integer; B: Char; C: array[1..4] of Integer end;
  PRec = ^Rec;
var
  G: array[1..10] of Integer;
  M: array[0..3, 0..3] of Integer;
  R, R2: Rec;
  P: PRec;
  S: string[20];
  I, J: Integer;
  Ch: Char;
  X: Integer absolute $1000;
  Y: Char absolute Ch;

procedure Proc(var V: Rec; W: Rec; K: Integer);
var L: array[1..3] of Integer;
  procedure Nested;
  begin
    L[K] := V.C[K] + W.C[2]
  end;
begin
  L[2] := K;
  V.C[K] := L[2];
  Nested
end;

begin
  G[3] := 1;
  G[I] := G[I + 1];
  M[I, J] := M[1, 2];
  R.C[I] := R.A;
  R2 := R;
  P^.C[2] := P^.A;
  with P^ do begin A := 5; B := 'b' end;
  with R do C[I] := A;
  Ch := S[I];
  Mem[$2000] := Mem[I];
  MemW[I] := X;
  Y := 'y';
  Proc(R, R2, 3)
end.
