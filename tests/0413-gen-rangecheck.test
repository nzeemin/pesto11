type Digit = 0..9;
var D: Digit; I: Integer;
begin
  I := 12;
  D := I;
  WriteLn('unchecked ', D);
  {$R+}
  I := 5; D := I; WriteLn('checked ', D);
  I := 10; D := I;
  WriteLn('never')
end.
