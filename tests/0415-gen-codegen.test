=== SOURCE ============================================================
program CodeGen;
var I, J, K: Integer; B: Byte; Bool: Boolean; S: string[10];
function F(X: Integer): Integer;
begin
  F := X
end;
begin
  I := Hi($1234) + Lo($1234);
  I := J shl 1; I := J shr 1; I := J shl 8; I := J shr 9; I := J * 8;
  Bool := I < J;
  Bool := Length(S) > 3;
  I := 13 - Length(S);
  I := J - F(K);
  I := F(J) - F(K);
  if I < Length(S) then K := 1;
  for I := 1 to 10 do K := K + I;
  for B := 255 downto J do K := K - 1;
  for I := J to K do B := B + 1;
  I := I + J; I := J + I; I := I - 1; I := I and $FF; I := I or J;
  B := B or 4; B := B and $F0
end.
