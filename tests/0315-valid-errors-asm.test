OPTIONS = -q
=== SOURCE ============================================================
program AsmErrors;
const RealC = 1.5; Str = 'abc'; N = 4;
type Rec = record A, B: Integer end;
var I: Integer; R: Rec; P: ^Integer; Port: Integer absolute $FF70;

procedure Outer(var V: Integer; W: Integer);
var L: Integer;
  procedure Inner;
  begin
    asm
        MOV     L, R0           ; enclosing procedure
    end
  end;
begin
  asm
        MOV     @V, R0          ; var parameter: only V
        MOV     V+2, R0
        MOV     #W, R0          ; local: no #
        MOV     L(R1), R0       ; local: no index
        MOV     Port(R1)+2, R0  ; text after the name
  end
end;

begin
  asm
        MOV     RealC, R0
        MOV     Str, R0
        MOV     R.C, R0         ; unknown field
        MOV     N.A, R0         ; constant with a field
        MOV     2+I, R0         ; name not at the start
        MOV     I+X, R0         ; not a constant
        MOV     I+9, R0         ; not an octal number
        MOV     @Port, R0       ; absolute with @ needs (Rn)
        MOV     Rec, R0         ; type
        .BLKW   COUNT
        .TITLE  X
I:      NOP                     ; warning
  end;
  inline($1234)
end.
