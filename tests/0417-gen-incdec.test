=== SOURCE ============================================================
program IncDec;
var I, J: Integer; B: Byte; C: Char; A: array[1..5] of Integer; BA: array[1..5] of Byte; P: ^Integer;
function F: Integer;
begin
  F := 1
end;
begin
  Inc(I); Dec(I); Inc(I, 5); Dec(I, 5); Inc(I, -1); Inc(I, 0);
  Inc(I, J); Dec(I, J + 1); Inc(I, F);
  Inc(B); Dec(C); Inc(B, 3); Dec(B, J);
  Inc(A[J]); Inc(A[J + 1], 2); Dec(BA[J], 4); Inc(P^); Inc(P^, J)
end.
