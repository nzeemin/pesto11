-q
----------------------------------------------------------------------
var I, J, K: Integer; B, F: Boolean;
begin
  I := 7; J := -3;
  WriteLn(I + J * 2, ' ', I div 2, ' ', J div 2, ' ', I mod 3, ' ', J mod 2);
  WriteLn(I shl 3, ' ', -16 shr 2, ' ', $F0 and $3C, ' ', I or 8, ' ', I xor 5, ' ', not I);
  K := 3; WriteLn(1 shl K, ' ', $8000 shr K, ' ', Abs(J), ' ', Sqr(J), ' ', Hi($1234), ' ', Lo($1234));
  B := I > J; F := not B;
  WriteLn(B, ' ', F, ' ', (I = 7) and (J < 0), ' ', B or F, ' ', B xor F, ' ', Odd(I));
  WriteLn(30000 + I * 1000, ' ', -I - J, ' ', (I + 1) * (J - 1))
end.
