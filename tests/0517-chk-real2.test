OPTIONS = -q
=== SOURCE ============================================================
program Check;
type Str12 = string[12];
var GP, GF, TP, TF: Integer; GN: Str12; Bad: string[40];
procedure Check(Ok: Boolean; N: Integer);
var S: string[5];
begin
  if Ok then GP := GP + 1 else
  begin
    GF := GF + 1; Str(N, S);
    if Length(Bad) < 34 then Bad := Bad + ' ' + S
  end
end;
procedure Done;
begin
  if GN <> '' then
  begin
    Write(GN, ' ':13 - Length(GN), 'PASS ', GP:3);
    if GF > 0 then Write(' FAIL ', GF, ':', Bad);
    WriteLn; TP := TP + GP; TF := TF + GF
  end;
  GP := 0; GF := 0; Bad := ''
end;
procedure Group(N: Str12);
begin
  Done; GN := N
end;
type Vec = array[1..5] of Real;
  Pt = record X, Y: Real end;
var V: Vec; P, Q: Pt; R, S: Real; I: Integer; T: string[20];
function Near(X, Y: Real): Boolean;
begin
  Near := Abs(X - Y) <= 1.0E-6 * (Abs(X) + Abs(Y))
end;
function Sum(A: Vec): Real;
var I: Integer; T: Real;
begin
  T := 0; for I := 1 to 5 do T := T + A[I]; Sum := T
end;
function Dist(A, B: Pt): Real;
begin
  Dist := Sqrt(Sqr(A.X - B.X) + Sqr(A.Y - B.Y))
end;
procedure Norm(var A: Pt);
var L: Real;
begin
  L := Sqrt(Sqr(A.X) + Sqr(A.Y)); A.X := A.X / L; A.Y := A.Y / L
end;
begin
  TP := 0; TF := 0; GN := ''; Done;
  Group('STRUCT');
  for I := 1 to 5 do V[I] := I / 2; Check(Sum(V) = 7.5, 1);
  V[3] := V[1] * V[2]; Check(V[3] = 0.5, 2);
  P.X := 0; P.Y := 0; Q.X := 3; Q.Y := 4; Check(Dist(P, Q) = 5, 3);
  Norm(Q); Check(Near(Q.X, 0.6) and Near(Q.Y, 0.8), 4);
  with P do begin X := 1.5; Y := X * 2 end; Check(P.Y = 3, 5);
  Group('ACCUM');
  R := 0; for I := 1 to 100 do R := R + 0.01; Check(Near(R, 1.0) or (Abs(R - 1) < 1.0E-4), 1);
  R := 1; for I := 1 to 10 do R := R * 10; Check(R = 1.0E10, 2);
  for I := 1 to 10 do R := R / 10; Check(Near(R, 1), 3);
  R := 1; S := 0; I := 0; while R > 1.0E-30 do begin R := R / 2; I := I + 1 end; Check((I > 90) and (I < 110), 4);
  Group('ROUNDING');
  Check(Round(0.5) = 1, 1); Check(Round(-0.5) = -1, 2); Check(Round(2.4999) = 2, 3);
  Check(Trunc(0.9999) = 0, 4); Check(Trunc(-0.9999) = 0, 5);
  Check(Int(7.0) = 7, 6); Check(Frac(-2.25) = -0.25, 7); Check(Int(0.3) = 0, 8);
  Check(Round(32767.4) = 32767, 9); Check(Round(-32767.6) = -32768, 10);
  Group('FORMAT');
  Str(0.0, T); Check(T = '  0.000000E+00', 1);
  Str(-1.5, T); Check(T = ' -1.500000E+00', 2);
  Str(123.456:8:2, T); Check(T = '  123.46', 3);
  Str(0.001:6:3, T); Check(T = ' 0.001', 4);
  Str(0.0004:6:3, T); Check(T = ' 0.000', 5);
  Str(0.0005:6:3, T); Check(T = ' 0.001', 6);
  Str(99.95:5:1, T); Check(T = '100.0', 7);
  Str(-2.5:1:0, T); Check(T = '-3', 8);
  Str(1.0E-5:9, T); Check(T = '1.000E-05', 9);
  Str(12345.0:0:0, T); Check(T = '12345', 10);
  Done;
  WriteLn('TOTAL PASS ', TP, ' FAIL ', TF)
end.
