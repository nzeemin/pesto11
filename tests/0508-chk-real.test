OPTIONS = -q
=== SOURCE ============================================================
program Check;
type Str12 = string[12];
var GP, GF, TP, TF: Integer; GN: Str12; Bad: string[40];
procedure Check(Ok: Boolean; N: Integer);
var S: string[5];
begin
  if Ok then GP := GP + 1 else
  begin
    GF := GF + 1; Str(N, S);
    if Length(Bad) < 34 then Bad := Bad + ' ' + S
  end
end;
procedure Done;
begin
  if GN <> '' then
  begin
    Write(GN, ' ':13 - Length(GN), 'PASS ', GP:3);
    if GF > 0 then Write(' FAIL ', GF, ':', Bad);
    WriteLn; TP := TP + GP; TF := TF + GF
  end;
  GP := 0; GF := 0; Bad := ''
end;
procedure Group(N: Str12);
begin
  Done; GN := N
end;
var A, B, R: Real; I, Code: Integer; S: string[20];
function Near(X, Y: Real): Boolean;
begin
  Near := Abs(X - Y) <= 1.0E-6 * (Abs(X) + Abs(Y))
end;
begin
  TP := 0; TF := 0; GN := ''; Done;
  Group('ARITH');
  A := 1.5; B := 2.25;
  Check(A + B = 3.75, 1); Check(A - B = -0.75, 2); Check(A * B = 3.375, 3);
  Check(B / A = 1.5, 4); Check(-A = -1.5, 5);
  I := 7; R := I / 2; Check(R = 3.5, 6);
  R := I; Check(R = 7.0, 7); R := I * A; Check(R = 10.5, 8);
  Check(Near(1 / 3 * 3, 1.0), 9);
  Group('COMPARE');
  Check(A < B, 1); Check(-A > -B, 2); Check(A <> B, 3); Check(A <= 1.5, 4);
  Check(0.0 = -0.0, 5); Check(1.0E-30 > 0, 6); Check(-1.0E30 < 1.0E-30, 7);
  Check(I > A, 8);
  Group('CONVERT');
  Check(Trunc(7.9) = 7, 1); Check(Trunc(-7.9) = -7, 2);
  Check(Round(7.5) = 8, 3); Check(Round(-7.5) = -8, 4); Check(Round(7.49) = 7, 5);
  Check(Int(-3.7) = -3.0, 6); Check(Near(Frac(3.75), 0.75), 7);
  Check(Trunc(32767.0) = 32767, 8); Check(Trunc(-32768.0) = -32768, 9);
  Group('MATH');
  Check(Sqrt(16.0) = 4.0, 1); Check(Near(Sqrt(2.0) * Sqrt(2.0), 2.0), 2);
  Check(Near(Sin(Pi / 6), 0.5), 3); Check(Near(Cos(0), 1.0), 4);
  Check(Near(ArcTan(1) * 4, Pi), 5); Check(Near(Exp(1), 2.718282), 6);
  Check(Near(Ln(Exp(2)), 2.0), 7); Check(Abs(-2.5) = 2.5, 8); Check(Sqr(-3.0) = 9.0, 9);
  Check(Near(Exp(Ln(10) * 2), 100.0), 10);
  Group('STR VAL');
  Str(3.14159:8:3, S); Check(S = '   3.142', 1);
  Str(-0.5:4:1, S); Check(S = '-0.5', 2);
  Str(2.0, S); Check(S = '  2.000000E+00', 3);
  Str(1.5E10:10, S); Check(S = '1.5000E+10', 4);
  Val('2.5E-3', R, Code); Check(Near(R, 0.0025) and (Code = 0), 5);
  Val('1e', R, Code); Check(Code = 3, 6);
  Val('-42', R, Code); Check((R = -42.0) and (Code = 0), 7);
  Group('LIMITS');
  R := 1.0E38; Check(R > 9.9E37, 1);
  R := 1.0E-38; Check((R > 0) and (R < 1.1E-38), 2);
  R := 1.0E-30; R := R * R; Check(R = 0.0, 3);
  Check(Random >= 0, 4); I := Random(10); Check((I >= 0) and (I < 10), 5);
  Done;
  WriteLn('TOTAL PASS ', TP, ' FAIL ', TF)
end.
