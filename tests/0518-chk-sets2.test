OPTIONS = -q
=== SOURCE ============================================================
program Check;
type Str12 = string[12];
var GP, GF, TP, TF: Integer; GN: Str12; Bad: string[40];
procedure Check(Ok: Boolean; N: Integer);
var S: string[5];
begin
  if Ok then GP := GP + 1 else
  begin
    GF := GF + 1; Str(N, S);
    if Length(Bad) < 34 then Bad := Bad + ' ' + S
  end
end;
procedure Done;
begin
  if GN <> '' then
  begin
    Write(GN, ' ':13 - Length(GN), 'PASS ', GP:3);
    if GF > 0 then Write(' FAIL ', GF, ':', Bad);
    WriteLn; TP := TP + GP; TF := TF + GF
  end;
  GP := 0; GF := 0; Bad := ''
end;
procedure Group(N: Str12);
begin
  Done; GN := N
end;
type Day = (Mon, Tue, Wed, Thu, Fri, Sat, Sun);
  Days = set of Day;
  Rec = record Work: Days; Letters: set of 'a'..'z' end;
  Bytes = set of Byte;
var W: array[1..3] of Days; R: Rec; B, B2: Bytes; D: Day; I, K: Integer; C: Char;
function Card(X: Days): Integer;
var D: Day; K: Integer;
begin
  K := 0; for D := Mon to Sun do if D in X then K := K + 1; Card := K
end;
procedure Toggle(var X: Days; D: Day);
begin
  if D in X then X := X - [D] else X := X + [D]
end;
begin
  TP := 0; TF := 0; GN := ''; Done;
  Group('IN RECORDS');
  R.Work := [Mon..Fri]; Check(Card(R.Work) = 5, 1);
  Toggle(R.Work, Fri); Toggle(R.Work, Sat); Check(R.Work = [Mon..Thu, Sat], 2);
  W[2] := R.Work * [Wed..Sun]; Check(W[2] = [Wed, Thu, Sat], 3);
  W[1] := []; for D := Mon to Sun do if Odd(Ord(D)) then W[1] := W[1] + [D];
  Check(W[1] = [Tue, Thu, Sat], 4);
  R.Letters := ['a'..'e']; C := 'c'; Check(C in R.Letters, 5);
  with R do Letters := Letters - ['c']; Check(not (C in R.Letters), 6);
  Group('BYTE SET');
  B := [0, 255]; Check((0 in B) and (255 in B) and not (128 in B), 1);
  B := []; for I := 0 to 255 do if I mod 17 = 0 then B := B + [I];
  K := 0; for I := 0 to 255 do if I in B then K := K + 1; Check(K = 16, 2);
  B2 := [0..255] - B; K := 0; for I := 0 to 255 do if I in B2 then K := K + 1; Check(K = 240, 3);
  Check(B * B2 = [], 4); Check(B + B2 = [0..255], 5);
  Check(B <= [0..255], 6); Check(not (B >= B2), 7);
  Group('MIXED');
  I := 3; K := 5;
  B := [I..K]; Check(B = [3, 4, 5], 1);
  B := [K..I]; Check(B = [], 2);
  B := [I, I + 1, K * 2]; Check(B = [3, 4, 10], 3);
  Check([Mon] + [Sun] = [Sun, Mon], 4);
  Check(Card([Mon..Sun] - [Sat, Sun]) = 5, 5);
  Done;
  WriteLn('TOTAL PASS ', TP, ' FAIL ', TF)
end.
=== SCREEN EXPECTED ===================================================
IN RECORDS   PASS   6
BYTE SET     PASS   7
MIXED        PASS   5
TOTAL PASS 18 FAIL 0
