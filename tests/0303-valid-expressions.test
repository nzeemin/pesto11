-q -v
----------------------------------------------------------------------
const N = 10; K = 3;
type Day = (Mon, Tue, Wed);
var I: Integer; B: Boolean; R: Real; C: Char; S: string[10]; D: Day; St: set of Day; A: array[1..3] of Char;
begin
  I := N * K + N div K - N mod K;
  I := 30000 + 30000;
  I := -N shl 2;
  I := $F0 and $3C or 1 xor 3;
  I := not 0;
  R := N / 4;
  R := I + R;
  B := (N > K) and not (C = 'x') or (I in [1..5]);
  B := 'abc' < 'abd';
  B := Tue > Mon;
  S := 'A' + C + S + A;
  St := [Mon, Wed] + St - [Tue];
  B := [Mon] <= St;
  B := nil = nil;
  I := Ord('A') + Ord(Wed) + Ord(Chr(66));
  C := Char(65); D := Day(2); I := Integer('7');
  I := Abs(-5) + Sqr(3); R := Abs(-1.5);
  C := Pred('B'); D := Succ(Mon); I := Succ(N);
  I := SizeOf(Day) + SizeOf(S) + SizeOf(Integer)
end.
----------------------------------------------------------------------
PROGRAM
  CONST N = 10 {Integer 10}
  CONST K = 3 {Integer 3}
  TYPE Day = (Mon, Tue, Wed) {size 1}
  VAR I: Integer {V00001, size 2}
  VAR B: Boolean {V00002, size 1}
  VAR R: Real {V00003, size 4}
  VAR C: Char {V00004, size 1}
  VAR S: string[10] {V00005, size 11}
  VAR D: Day {V00006, size 1}
  VAR St: set of Day {V00007, size 1}
  VAR A: array[1..3] of Char {V00008, size 3}
  BEGIN
    ASSIGN I := 32
    ASSIGN I := -5536
    ASSIGN I := -40
    ASSIGN I := 50
    ASSIGN I := -1
    ASSIGN R := 2.5
    ASSIGN R := (ToReal(I) + R)
    ASSIGN B := ((True and (not (C = 'x'))) or (I in [1..5]))
    ASSIGN B := True
    ASSIGN B := True
    ASSIGN S := (((ToString('A') + ToString(C)) + S) + ToString(A))
    ASSIGN St := (([0, 2] + St) - [1])
    ASSIGN B := ([0] <= St)
    ASSIGN B := (nil = nil)
    ASSIGN I := 133
    ASSIGN C := 'A'
    ASSIGN D := Wed
    ASSIGN I := 55
    ASSIGN I := 14
    ASSIGN R := 1.5
    ASSIGN C := 'A'
    ASSIGN D := Tue
    ASSIGN I := 11
    ASSIGN I := 14
