OPTIONS = -q
=== SOURCE ============================================================
program Inp;
var I, J: Integer; R: Real; S: string[10]; C, D: Char;
begin
  ClrScr;
  Write('I J? '); ReadLn(I, J); WriteLn('Sum=', I + J);
  Write('R? '); ReadLn(R); WriteLn(R:8:3);
  Write('S? '); ReadLn(S); WriteLn('[', S, ']');
  Write('C D? '); Read(C, D); WriteLn(Ord(C), ' ', Ord(D));
  I := 5; Write('Empty? '); ReadLn(I); WriteLn('I=', I, ' ', Eoln);
  BufLen := 3; Write('Buf? '); ReadLn(S); WriteLn('[', S, ']');
  GotoXY(30, 2); Write('AT30,2'); ClrEol;
  GotoXY(1, 16);
  while not KeyPressed do;
  Read(Kbd, C, D);
  WriteLn('Kbd ', Ord(C), ' ', Ord(D));
  Delay(500);
  WriteLn('Done');
  Write('Bad? '); ReadLn(I)
end.
