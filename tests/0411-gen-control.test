OPTIONS = -q
=== SOURCE ============================================================
label 1;
type Day = (Mon, Tue, Wed, Thu, Fri);
var I, J, K: Integer; C: Char; D: Day; S: 0..200;
begin
  C := 'A'; C := Succ(C); WriteLn(C, Ord(C):4, Chr(Ord(C) + 1):2);
  K := 0;
  for I := 1 to 10 do K := K + I;
  Write('Sum=', K);
  for C := 'z' downto 'x' do Write(' ', C);
  WriteLn;
  for D := Mon to Fri do Write(Ord(D));
  WriteLn;
  I := 0; J := -3;
  while I < 5 do I := I + 2;
  repeat J := J + 1 until J >= 3;
  WriteLn('I=', I, ' J=', J);
  for I := 1 to 6 do
    case I of
      1: Write('one ');
      2, 3: Write('two-three ');
      4..5: Write('four-five ');
    else Write('other')
    end;
  WriteLn;
  if C in ['a'..'z'] then WriteLn('lower') else WriteLn('upper');
  if not (I in [1, 3, 5]) then WriteLn('not odd small');
  I := 0;
1: I := I + 1;
  if I < 3 then goto 1;
  WriteLn('goto I=', I);
  S := 200; WriteLn(S);
  for I := 3 to 1 do WriteLn('never')
end.
