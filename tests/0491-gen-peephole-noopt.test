OPTIONS = -q --noopt
=== SOURCE ============================================================
program Peep;
var I, J, K: Integer; X, Y: Real; B: Boolean; P: ^Integer;
  A: array[1..3] of Integer;

procedure Quit(N: Integer);
begin
  if N > 0 then Exit;
  I := N
end;

function Neg(N: Integer): Integer;
begin
  Neg := -N
end;

begin
  X := 1.5; Y := X * 2.0;
  I := J div K;
  I := J * K;
  I := Neg(J) + 1;
  New(P); P^ := I;
  A[I] := A[J];
  if B then I := 1 else I := 2;
  while I < 10 do
  begin
    if I = 5 then I := 7;
    I := I + 1
  end;
  repeat
    I := I - 1
  until I = 0;
  Quit(3)
end.
