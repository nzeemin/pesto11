program Check;
type Str12 = string[12];
var GP, GF, TP, TF: Integer; GN: Str12; Bad: string[40];
procedure Check(Ok: Boolean; N: Integer);
var S: string[5];
begin
  if Ok then GP := GP + 1 else
  begin
    GF := GF + 1; Str(N, S);
    if Length(Bad) < 34 then Bad := Bad + ' ' + S
  end
end;
procedure Done;
begin
  if GN <> '' then
  begin
    Write(GN, ' ':13 - Length(GN), 'PASS ', GP:3);
    if GF > 0 then Write(' FAIL ', GF, ':', Bad);
    WriteLn; TP := TP + GP; TF := TF + GF
  end;
  GP := 0; GF := 0; Bad := ''
end;
procedure Group(N: Str12);
begin
  Done; GN := N
end;
var A, F, G: Real; BI, Code: Integer; S: string[20];
function Tan(X: Real): Real;
begin
  Tan := Sin(X) / Cos(X)
end;
begin
  TP := 0; TF := 0; GN := ''; Done;
  Group('COS');
  A := Cos(0);
  Check(Abs(A - 1.0) < 0.00001, 1);
  F := 0.0;
  A := Cos(F);
  Check(Abs(A - 1.0) < 0.00001, 2);
  A := Cos(Pi/3);
  Check(Abs(A - 0.5) < 0.00001, 3);
  F := Pi/3;
  A := Cos(F);
  Check(Abs(A - 0.5) < 0.00001, 4);
  A := Cos(Pi/4);
  Check(Abs(A - 0.7071068) < 0.00001, 5);
  A := Cos(Pi/2);
  Check(Abs(A) < 0.0001, 6);
  F := Pi/2;
  A := Cos(F);
  Check(Abs(A) < 0.0001, 7);
  A := Cos(Pi);
  Check((Abs(A + 1.0) < 0.00001) and (A >= -1.000001), 8);
  A := Cos(1);
  Check(Abs(A - 0.5403023) < 0.00001, 9);
  F := 1.0;
  A := Cos(F);
  Check(Abs(A - 0.5403023) < 0.00001, 10);
  BI := 1;
  A := Cos(BI);
  Check(Abs(A - 0.5403023) < 0.00001, 11);
  BI := -1;
  A := Cos(BI);
  Check(Abs(A - 0.5403023) < 0.00001, 12);
  A := Cos(0.5);
  Check(Abs(A - 0.8775826) < 0.00001, 13);
  F := 0.5;
  A := Cos(F);
  Check(Abs(A - 0.8775826) < 0.00001, 14);
  A := Cos(2);
  Check(Abs(A + 0.4161468) < 0.00001, 15);
  A := Cos(3);
  Check(Abs(A + 0.9899925) < 0.00001, 16);
  F := 0.7;
  A := Cos(-F) - Cos(F);
  Check(Abs(A) < 0.00001, 17);
  A := Cos(F) * Cos(F) + Sin(F) * Sin(F);
  Check(Abs(A - 1.0) < 0.0001, 18);
  A := Cos(F + F) - 1.0 + 2.0 * Sin(F) * Sin(F);
  Check(Abs(A) < 0.0001, 19);
  F := 1.0;
  A := Cos(F + F);
  Check(Abs(A + 0.4161468) < 0.00001, 20);
  Group('TAN');
  A := Tan(0);
  Check(Abs(A) < 0.00001, 1);
  A := Tan(Pi/4);
  Check(Abs(A - 1.0) < 0.00001, 2);
  F := Pi/4;
  A := Tan(F);
  Check(Abs(A - 1.0) < 0.00001, 3);
  A := Tan(-Pi/4);
  Check(Abs(A + 1.0) < 0.00001, 4);
  F := -Pi/4;
  A := Tan(F);
  Check(Abs(A + 1.0) < 0.00001, 5);
  A := Tan(1);
  Check(Abs(A - 1.557408) < 0.00001, 6);
  F := 1.0;
  A := Tan(F);
  Check(Abs(A - 1.557408) < 0.00001, 7);
  BI := 1;
  A := Tan(BI);
  Check(Abs(A - 1.557408) < 0.00001, 8);
  BI := -1;
  A := Tan(BI);
  Check(Abs(A + 1.557408) < 0.00001, 9);
  A := Tan(0.5);
  Check(Abs(A - 0.5463025) < 0.00001, 10);
  F := 0.5;
  A := Tan(F);
  Check(Abs(A - 0.5463025) < 0.00001, 11);
  A := Tan(-0.5);
  Check(Abs(A + 0.5463025) < 0.00001, 12);
  A := Tan(0.1);
  Check(Abs(A - 0.1003347) < 0.00001, 13);
  A := Tan(2);
  Check(Abs(A + 2.18504) < 0.0001, 14);
  A := Tan(3);
  Check(Abs(A + 0.1425465) < 0.00001, 15);
  A := Tan(1.5);
  Check(Abs(A - 14.10142) < 0.001, 16);
  F := 1.5;
  A := Tan(F);
  Check(Abs(A - 14.10142) < 0.001, 17);
  F := 0.7;
  A := Tan(-F) + Tan(F);
  Check(Abs(A) < 0.00001, 18);
  A := Tan(F) - Sin(F) / Cos(F);
  Check(Abs(A) < 0.00001, 19);
  A := Tan(F) - Tan(F + Pi);
  Check(Abs(A) < 0.0001, 20);
  F := 0.3;
  A := Tan(ArcTan(F)) - F;
  Check(Abs(A) < 0.00001, 21);
  F := 1.0;
  A := Tan(F + F);
  Check(Abs(A + 2.18504) < 0.0001, 22);
  Done;
  WriteLn('TOTAL PASS ', TP, ' FAIL ', TF)
end.
