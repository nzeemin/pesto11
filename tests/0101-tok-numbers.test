OPTIONS = -q -t
=== SOURCE ============================================================
x := 0 + 123 + $FF + $ffff + 1.5 + 2E-5 + 1.25e+3 + 7e2;
for i := 1..10 do a[1.)
=== OUTPUT ============================================================
1,1 IDENT x
1,3 SYMBOL :=
1,6 INTEGER 0
1,8 SYMBOL +
1,10 INTEGER 123
1,14 SYMBOL +
1,16 INTEGER $FF=255
1,20 SYMBOL +
1,22 INTEGER $ffff=65535
1,28 SYMBOL +
1,30 REAL 1.5
1,34 SYMBOL +
1,36 REAL 2E-5
1,41 SYMBOL +
1,43 REAL 1.25e+3
1,51 SYMBOL +
1,53 REAL 7e2
1,56 SYMBOL ;
2,1 KEYWORD FOR
2,5 IDENT i
2,7 SYMBOL :=
2,10 INTEGER 1
2,11 SYMBOL ..
2,13 INTEGER 10
2,16 KEYWORD DO
2,19 IDENT a
2,20 SYMBOL [
2,21 INTEGER 1
2,22 SYMBOL ]
3,1 EOF
