-q -p
----------------------------------------------------------------------
begin
  A := 1;
  {$R+}
  A := 2;
  B := 3;
  {$R-,I-}
  C := 4;
  {$I+}
  D := 5
end.
----------------------------------------------------------------------
PROGRAM
  BEGIN
    ASSIGN A := 1
    ASSIGN A := 2 {$R+}
    ASSIGN B := 3
    ASSIGN C := 4 {$I-}
    ASSIGN D := 5 {$defaults}
