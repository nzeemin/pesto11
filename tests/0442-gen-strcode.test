OPTIONS = -q
=== SOURCE ============================================================
type Str20 = string[20];
var S, T: Str20; C: Char; I: Integer;
function F(X: Str20; K: Integer): Str20;
begin
  F := Copy(X, K, 3)
end;
begin
  S := T;
  S := S + C;
  T := F(S + T, I) + 'z';
  I := Length(S) + Pos('a', T);
  if S = T then C := S[1];
  Write(S + T)
end.
