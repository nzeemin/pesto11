OPTIONS = -q -v
=== SOURCE ============================================================
var I, Code: Integer; R: Real; S: string[20]; C: Char; F: Text; T: file of Integer; P: ^Integer; B: Boolean;
begin
  Write('I=', I:5, ' R=', R:8:2, R:10, C, B, S);
  WriteLn; WriteLn(F, 'x'); Write(T, I);
  Read(I, R, C, S); ReadLn; ReadLn(F, S); Read(T, I);
  Str(I:4, S); Str(R:8:3, S); Val(S, R, Code); Val('12', I, Code);
  S := Concat('a', S, C); S := Copy(S, 1, 2); I := Length(S) + Pos('a', S);
  Delete(S, 1, 1); Insert('x', S, 2); C := UpCase(C);
  Assign(F, 'A.TXT'); Reset(F); Rewrite(T); Close(F); B := Eof(F) or Eoln or Eof;
  New(P); Dispose(P); GetMem(P, 10); I := MemAvail;
  R := Sqrt(2) + Sin(R) + Random; I := Random(10) + Round(R) + Trunc(R);
  I := Hi(I) + Lo(I) + Swap(I) + Ord(Odd(I));
  FillChar(S, SizeOf(S), ' '); Move(I, Code, 2);
  GotoXY(1, 2); ClrScr; Delay(100); I := Mem[$80] + Addr(I);
  if KeyPressed then Halt
end.
=== OUTPUT ============================================================
PROGRAM
  VAR I, Code: Integer {V00001, V00002, size 2}
  VAR R: Real {V00003, size 4}
  VAR S: string[20] {V00004, size 21}
  VAR C: Char {V00005, size 1}
  VAR F: Text {V00006, size 528}
  VAR T: file of Integer {V00007, size 528}
  VAR P: ^Integer {V00008, size 2}
  VAR B: Boolean {V00009, size 1}
  BEGIN
    CALL Write('I=', I:5, ' R=', R:8:2, R:10, C, B, S)
    CALL WriteLn
    CALL WriteLn(F, 'x')
    CALL Write(T, I)
    CALL Read(I, R, C, S)
    CALL ReadLn
    CALL ReadLn(F, S)
    CALL Read(T, I)
    CALL Str(I:4, S)
    CALL Str(R:8:3, S)
    CALL Val(S, R, Code)
    CALL Val('12', I, Code)
    ASSIGN S := Concat(ToString('a'), S, ToString(C))
    ASSIGN S := Copy(S, 1, 2)
    ASSIGN I := (Length(S) + Pos(ToString('a'), S))
    CALL Delete(S, 1, 1)
    CALL Insert(ToString('x'), S, 2)
    ASSIGN C := UpCase(C)
    CALL Assign(F, 'A.TXT')
    CALL Reset(F)
    CALL Rewrite(T)
    CALL Close(F)
    ASSIGN B := ((Eof(F) or Eoln) or Eof)
    CALL New(P)
    CALL Dispose(P)
    CALL GetMem(P, 10)
    ASSIGN I := MemAvail
    ASSIGN R := ((Sqrt(ToReal(2)) + Sin(R)) + Random)
    ASSIGN I := ((Random(10) + Round(R)) + Trunc(R))
    ASSIGN I := (((Hi(I) + Lo(I)) + Swap(I)) + Ord(Odd(I)))
    CALL FillChar(S, 21, ' ')
    CALL Move(I, Code, 2)
    CALL GotoXY(1, 2)
    CALL ClrScr
    CALL Delay(100)
    ASSIGN I := (Mem[$80] + Addr(I))
    IF KeyPressed
      THEN
        CALL Halt
