OPTIONS = -q
=== SOURCE ============================================================
program Check;
type Str12 = string[12];
var GP, GF, TP, TF: Integer; GN: Str12; Bad: string[40];
procedure Check(Ok: Boolean; N: Integer);
var S: string[5];
begin
  if Ok then GP := GP + 1 else
  begin
    GF := GF + 1; Str(N, S);
    if Length(Bad) < 34 then Bad := Bad + ' ' + S
  end
end;
procedure Done;
begin
  if GN <> '' then
  begin
    Write(GN, ' ':13 - Length(GN), 'PASS ', GP:3);
    if GF > 0 then Write(' FAIL ', GF, ':', Bad);
    WriteLn; TP := TP + GP; TF := TF + GF
  end;
  GP := 0; GF := 0; Bad := ''
end;
procedure Group(N: Str12);
begin
  Done; GN := N
end;
type Arr = array[1..5] of Integer;
  Rec = record X, Y: Integer; C: Char end;
var G: Integer; A: Arr; R: Rec;
function Fact(N: Integer): Integer;
begin
  if N <= 1 then Fact := 1 else Fact := N * Fact(N - 1)
end;
function Ack(M, N: Integer): Integer;
begin
  if M = 0 then Ack := N + 1
  else if N = 0 then Ack := Ack(M - 1, 1)
  else Ack := Ack(M - 1, Ack(M, N - 1))
end;
procedure SwapI(var X, Y: Integer);
var T: Integer;
begin
  T := X; X := Y; Y := T
end;
procedure Level1(P: Integer);
var L1: Integer;
  procedure Level2(Q: Integer);
  var L2: Integer;
    procedure Level3;
    begin
      L1 := L1 + 1; L2 := L2 + 10; G := G + P + Q
    end;
  begin
    L2 := 0; Level3; Level3; L1 := L1 + L2
  end;
begin
  L1 := 0; Level2(5); G := G + L1
end;
function MaxOf(V: Arr): Integer;
var I, M: Integer;
begin
  M := V[1];
  for I := 2 to 5 do if V[I] > M then M := V[I];
  V[1] := 0; MaxOf := M
end;
procedure SetRec(var Z: Rec; N: Integer);
begin
  Z.X := N; Z.Y := -N; Z.C := Chr(64 + N)
end;
function IsEven(N: Integer): Boolean; forward;
function IsOdd(N: Integer): Boolean;
begin
  if N = 0 then IsOdd := False else IsOdd := IsEven(N - 1)
end;
function IsEven;
begin
  if N = 0 then IsEven := True else IsEven := IsOdd(N - 1)
end;
function FirstChar(S: Str12): Char;
begin
  FirstChar := S[1]
end;
begin
  TP := 0; TF := 0; GN := ''; Done;
  Group('RECURSION');
  Check(Fact(7) = 5040, 1); Check(Fact(1) = 1, 2); Check(Ack(2, 3) = 9, 3);
  Check(IsEven(10), 4); Check(IsOdd(7), 5); Check(not IsEven(7), 6);
  Group('VAR PARAMS');
  A[2] := 7; A[4] := 9; SwapI(A[2], A[4]); Check((A[2] = 9) and (A[4] = 7), 1);
  R.X := 1; R.Y := 2; SwapI(R.X, R.Y); Check((R.X = 2) and (R.Y = 1), 2);
  SetRec(R, 3); Check((R.X = 3) and (R.Y = -3) and (R.C = 'C'), 3);
  G := 4; SwapI(G, A[2]); Check((G = 9) and (A[2] = 4), 4);
  Group('NESTED');
  G := 0; Level1(2); Check(G = 36, 1);
  Group('VALUE PARAMS');
  A[1] := 3; A[2] := 8; A[3] := -1; A[4] := 5; A[5] := 2;
  Check(MaxOf(A) = 8, 1); Check(A[1] = 3, 2);
  Check(FirstChar('Hello') = 'H', 3);
  Done;
  WriteLn('TOTAL PASS ', TP, ' FAIL ', TF)
end.
