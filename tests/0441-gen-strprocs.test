OPTIONS = -q
=== SOURCE ============================================================
program Step5;
type
  Name = string[10];
  Str255 = string[255];
  Rec = record N: Name; Age: Integer end;
var
  S, T: string[20];
  Short: string[5];
  N: Name;
  C: Char;
  I, Code: Integer;
  A: array[1..4] of Char;
  R: Rec;
  L: array[1..3] of Name;

function Greet(Who: Name): Str255;
begin
  Greet := 'Hi, ' + Who + '!'
end;

function Twice(X: Str255): Str255;
begin
  Twice := X + X
end;

procedure Shout(var X: Name);
var I: Integer;
begin
  for I := 1 to Length(X) do X[I] := UpCase(X[I])
end;

function CountChar(St: Str255; Ch: Char): Integer;
var I, K: Integer;
begin
  K := 0;
  for I := 1 to Length(St) do if St[I] = Ch then K := K + 1;
  CountChar := K
end;

begin
  A := 'abcd';
  S := A;
  WriteLn('A=', S, ' ', A = 'abcd', ' ', S + A);
  S := '0123456789';
  Delete(S, 3, 4);
  WriteLn('Delete=', S);
  Insert('ABC', S, 2);
  WriteLn('Insert=', S);
  Insert('!', S, 99);
  WriteLn('Insert=', S);
  Short := 'abc';
  Insert('XYZ', Short, 2);
  WriteLn('Short=', Short);
  Str(1234, S); Str(-56:6, T);
  WriteLn('Str=[', S, '][', T, ']');
  Str(-32768, S);
  WriteLn('Str=', S);
  Val('-123', I, Code); Write('Val=', I, ' ', Code);
  Val('12x', I, Code); Write(' ', Code);
  Val('$1F', I, Code); Write(' ', I, ' ', Code);
  Val('32768', I, Code); WriteLn(' ', Code);
  R.N := 'Ann'; R.Age := 30;
  L[2] := R.N + '!';
  WriteLn('Rec=', R.N, ' ', L[2], ' ', Length(L[2]));
  S := 'abc';
  C := S[2];
  S[0] := Chr(2);
  WriteLn('Idx=', C, ' ', S, ' ', Ord(T[0]));
  C := Copy('qwe', 2, 1);
  WriteLn('C=', C, ' ', 'end':6, Short:5);
  C := S;
end.
