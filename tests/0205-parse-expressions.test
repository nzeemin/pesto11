-q -p
----------------------------------------------------------------------
begin
  A := not -J + Ord(B) * N div 2 mod 3 shl 1;
  A := (I < N) and not (J in [1, 3..5]);
  A := a * -b - -c / d;
  A := a or b xor c and d shr 2;
  A := (a + b) * (c - d);
  A := X <= Y;
  A := [];
  A := F(G(x), [a..b]) + nil = P;
  A := Integer('7') + Char(78);
end.
----------------------------------------------------------------------
PROGRAM
  BEGIN
    ASSIGN A := ((not (-J)) + ((((Ord(B) * N) div 2) mod 3) shl 1))
    ASSIGN A := ((I < N) and (not (J in [1, 3..5])))
    ASSIGN A := ((a * (-b)) - ((-c) / d))
    ASSIGN A := ((a or b) xor ((c and d) shr 2))
    ASSIGN A := ((a + b) * (c - d))
    ASSIGN A := (X <= Y)
    ASSIGN A := []
    ASSIGN A := ((F(G(x), [a..b]) + nil) = P)
    ASSIGN A := (Integer('7') + Char(78))
    EMPTY
