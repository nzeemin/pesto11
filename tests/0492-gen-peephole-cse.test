OPTIONS = -q
=== SOURCE ============================================================
program Cse;
{ Peephole RepeatedValue: a value computed again while a register holds it }
var A: array[0..4, 0..2] of Byte; I, K: Integer; X: Real;
begin
  { the same index three times in one condition }
  if (A[I, 0] <> 0) and (A[I, 1] = A[I, 0]) and (A[I, 2] = A[I, 0]) then K := 1;
  { a write to memory between: the index is computed again }
  K := A[I, 1]; I := 2; K := K + A[I, 1];
  { the same constant into another register }
  WriteLn(X)
end.
