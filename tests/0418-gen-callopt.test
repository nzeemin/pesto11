OPTIONS = -q
=== SOURCE ============================================================
program CallOpt;
{ Function result straight in R0, Boolean arguments straight on the stack }
var I, J: Integer; B: Byte;
function Twice(N: Integer): Integer;
begin
  Twice := N + N
end;
function Seven: Integer;
begin
  Seven := 7
end;
function NextByte(V: Byte): Byte;
begin
  NextByte := V + 1
end;
function Sign(N: Integer): Integer;
begin
  Sign := 0;
  if N > 0 then Sign := 1;
  if N < 0 then Sign := -1
end;
function Both(A, C: Boolean): Boolean;
begin
  Both := A and C
end;
begin
  I := Twice(Seven); B := NextByte(B); J := Sign(I);
  if Both(I < J, (I > 0) or (J = 0)) then I := 0;
  if Both(not (I = 0), I in [1..5]) then J := 0
end.
