OPTIONS = -q
=== SOURCE ============================================================
type Big = array[1..1000] of Integer;
var P: ^Big; N: Integer;
begin
  N := 0;
  WriteLn('free ', MaxAvail <> 0);
  repeat
    New(P); P^[1000] := N; N := N + 1
  until N > 100;
  WriteLn('never')
end.
