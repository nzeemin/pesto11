  K := 0; for B := B2 to 4 do K := K + 1; Check(K = 2, 13);
  K := 0; for I := 1 to 1 do K := K + 1; Check(K = 1, 14);
  K := 0; for I := 32766 to 32767 do K := K + 1; Check((K = 2) and (I = 32767), 15);
  Group('INPLACE');
  I := 5; J := 7;
  I := I + J; Check(I = 12, 1); I := J + I; Check(I = 19, 2);
  I := I - 4; Check(I = 15, 3); I := I + 1; Check(I = 16, 4); I := I - 1; Check(I = 15, 5);
  I := I + (-1); Check(I = 14, 6); I := I + 0; Check(I = 14, 7);
  I := I and $FC; Check(I = 12, 8); I := I or J; Check(I = 15, 9); I := I or 16; Check(I = 31, 10);
  B := 254; B := B + 1; Check(B = 255, 11); B := B - 1; Check(B = 254, 12);
  B := B and $0F; Check(B = 14, 13); B := B or $30; Check(B = $3E, 14);
  A[2] := 10; A[2] := A[2] + 5; Check(A[2] = 15, 15);
  R.M := 3; R.M := R.M + R.M; Check(R.M = 6, 16);
  I := 3; I := 10 - I; Check(I = 7, 17);
  Group('FOROUTER');
