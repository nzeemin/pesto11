OPTIONS = -q
=== SOURCE ============================================================
program GenAsm;
const Max = 10; Neg = -3; Ch = 'A'; Flag = True;
type Rec = record N, M: Integer end;
var I, J: Integer; R: Rec; Port: Integer absolute $FF70; Over: Integer absolute J;
label Done;

procedure P(var V: Integer; W: Integer);
var L: Integer; LR: Rec;
begin
  asm
1$:     MOV     V, R0           ; @n(R5)
        MOV     W, R1
        MOV     LR.M, L
        MOV     L+2, R2
        MOV     @L, R3
        MOV     #Max*2+Neg, R2
  end
end;

function F(X: Integer): Integer;
begin
  asm MOV X, F end
end;

begin
  asm
        MOV     #Max, I
        MOV     R.M, J
        MOV     R+2(R1), J
        MOV     #R, R0
        MOV     @R, R0
        MOV     Over, R0
        MOV     Port, R0
        MOV     #Port, R0
        MOV     Port+2(R1), R0
        MOV     @Port(R1), R0
        MOV     #Ch, R0
        MOV     #Flag, R0
        MOV     #Neg, R0
        MOV     #<2*Neg>, R0
        CALL    P
        MOV     #F, R0
        JMP     Done
        .WORD   I, J, P, Max
        .BLKW   Max
  end;
  while I > 0 do
  begin
    asm
        DEC     I
        .BLKW   200.
    end
  end;
  asm
        CALL    WRCH            ; runtime block
  end;
Done:
end.
