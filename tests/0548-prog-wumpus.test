OPTIONS = -q
FRAMES = 300
KEYS WAIT = 300
=== SOURCE ============================================================
PROGRAM WUMPUS;
{ Hunt the Wumpus, by Gregory Yob, 1973 (Creative Computing, 1975).
  Translated from the BASIC original into Turbo Pascal 3.0.
  The cave is a dodecahedron: 20 rooms, 3 tunnels from each. LOC[1] is you,
  LOC[2] the wumpus, LOC[3..4] the pits, LOC[5..6] the bats.
  STATE: 0 the game goes on, 1 you won, -1 you lost.
  Test variant of examples/wumpus/WUMPUS.PAS: no RANDOMIZE, and the game
  ends when the answer to SAME SET-UP is not Y. }
CONST CAVE: ARRAY[1..20, 1..3] OF INTEGER = (
	(2, 5, 8), (1, 3, 10), (2, 4, 12), (3, 5, 14), (1, 4, 6),
	(5, 7, 15), (6, 8, 17), (1, 7, 9), (8, 10, 18), (2, 9, 11),
	(10, 12, 19), (3, 11, 13), (12, 14, 20), (4, 13, 15), (6, 14, 16),
	(15, 17, 20), (7, 16, 18), (9, 17, 19), (11, 18, 20), (13, 16, 19));
TYPE	LOCATIONS = ARRAY[1..6] OF INTEGER;
VAR	LOC, SAVED: LOCATIONS;
	PATH: ARRAY[1..5] OF INTEGER;
	ARROWS, STATE: INTEGER;

{ An answer like Y or N: the first letter of the line }
FUNCTION ASK: CHAR;
VAR S: STRING[20];
BEGIN
	WRITE('? ');
	READLN(S);
	IF LENGTH(S) = 0 THEN S := ' ';
	ASK := UPCASE(S[1])
END;

{ A number; asks again until the line is a number }
FUNCTION ASKNUMBER: INTEGER;
VAR S: STRING[20];
	N, CODE: INTEGER;
BEGIN
	REPEAT
		WRITE('? ');
		READLN(S);
		VAL(S, N, CODE)
	UNTIL CODE = 0;
	ASKNUMBER := N
END;

FUNCTION ADJACENT(ROOM, OTHER: INTEGER): BOOLEAN;
BEGIN
	ADJACENT := (CAVE[ROOM, 1] = OTHER) OR (CAVE[ROOM, 2] = OTHER) OR (CAVE[ROOM, 3] = OTHER)
END;

PROCEDURE INSTRUCTIONS;
BEGIN
	WRITELN('WELCOME TO ''HUNT THE WUMPUS''');
	WRITELN('  THE WUMPUS LIVES IN A CAVE OF 20 ROOMS. EACH ROOM');
	WRITELN('HAS 3 TUNNELS LEADING TO OTHER ROOMS. (LOOK AT A');
	WRITELN('DODECAHEDRON TO SEE HOW THIS WORKS-IF YOU DON''T KNOW');
	WRITELN('WHAT A DODECAHEDRON IS, ASK SOMEONE)');
	WRITELN;
	WRITELN('     HAZARDS:');
	WRITELN(' BOTTOMLESS PITS - TWO ROOMS HAVE BOTTOMLESS PITS IN THEM');
	WRITELN('     IF YOU GO THERE, YOU FALL INTO THE PIT (& LOSE!)');
	WRITELN(' SUPER BATS - TWO OTHER ROOMS HAVE SUPER BATS. IF YOU');
	WRITELN('     GO THERE, A BAT GRABS YOU AND TAKES YOU TO SOME OTHER');
	WRITELN('     ROOM AT RANDOM. (WHICH MIGHT BE TROUBLESOME)');
	WRITELN;
	WRITELN('     WUMPUS:');
	WRITELN(' THE WUMPUS IS NOT BOTHERED BY THE HAZARDS (HE HAS SUCKER');
	WRITELN(' FEET AND IS TOO BIG FOR A BAT TO LIFT).  USUALLY');
	WRITELN(' HE IS ASLEEP. TWO THINGS WAKE HIM UP: YOUR ENTERING');
	WRITELN(' HIS ROOM OR YOUR SHOOTING AN ARROW.');
	WRITELN('     IF THE WUMPUS WAKES, HE MOVES (P=.75) ONE ROOM');
	WRITELN(' OR STAYS STILL (P=.25). AFTER THAT, IF HE IS WHERE YOU');
	WRITELN(' ARE, HE EATS YOU UP (& YOU LOSE!)');
	WRITELN;
	WRITELN('     YOU:');
	WRITELN(' EACH TURN YOU MAY MOVE OR SHOOT A CROOKED ARROW');
	WRITELN('   MOVING: YOU CAN GO ONE ROOM (THRU ONE TUNNEL)');
	WRITELN('   ARROWS: YOU HAVE 5 ARROWS. YOU LOSE WHEN YOU RUN OUT.');
	WRITELN('   EACH ARROW CAN GO FROM 1 TO 5 ROOMS. YOU AIM BY TELLING');
	WRITELN('   THE COMPUTER THE ROOM#S YOU WANT THE ARROW TO GO TO.');
	WRITELN('   IF THE ARROW CAN''T GO THAT WAY (IE NO TUNNEL) IT MOVES');
	WRITELN('   AT RANDOM TO THE NEXT ROOM.');
	WRITELN('     IF THE ARROW HITS THE WUMPUS, YOU WIN.');
	WRITELN('     IF THE ARROW HITS YOU, YOU LOSE.');
	WRITELN;
	WRITELN('    WARNINGS:');
	WRITELN('     WHEN YOU ARE ONE ROOM AWAY FROM WUMPUS OR HAZARD,');
	WRITELN('    THE COMPUTER SAYS:');
	WRITELN(' WUMPUS-  ''I SMELL A WUMPUS''');
	WRITELN(' BAT   -  ''BATS NEARBY''');
	WRITELN(' PIT   -  ''I FEEL A DRAFT''');
	WRITELN
END;

{ The six locations at random, all different }
PROCEDURE PLACE;
VAR J, K: INTEGER;
	SAME: BOOLEAN;
BEGIN
	REPEAT
		FOR J := 1 TO 6 DO LOC[J] := RANDOM(20) + 1;
		SAME := FALSE;
		FOR J := 1 TO 5 DO
			FOR K := J + 1 TO 6 DO
				IF LOC[J] = LOC[K] THEN SAME := TRUE
	UNTIL NOT SAME;
	SAVED := LOC
END;

{ Hazard warnings and the location }
PROCEDURE WARNINGS;
VAR J, K, ROOM: INTEGER;
BEGIN
	WRITELN;
	ROOM := LOC[1];
	FOR J := 2 TO 6 DO
		FOR K := 1 TO 3 DO
			IF CAVE[ROOM, K] = LOC[J] THEN
				CASE J OF
				2: WRITELN('I SMELL A WUMPUS!');
				3, 4: WRITELN('I FEEL A DRAFT');
				5, 6: WRITELN('BATS NEARBY!')
				END;
	WRITELN('YOU ARE IN ROOM ', ROOM);
	WRITELN('TUNNELS LEAD TO ', CAVE[ROOM, 1], ' ', CAVE[ROOM, 2], ' ', CAVE[ROOM, 3]);
	WRITELN
END;

{ Shoot or move: 'S' or 'M' }
FUNCTION CHOOSE: CHAR;
VAR C: CHAR;
BEGIN
	REPEAT
		WRITE('SHOOT OR MOVE (S-M)');
		C := ASK
	UNTIL (C = 'S') OR (C = 'M');
	CHOOSE := C
END;

{ The wumpus wakes: moves through one of the 3 tunnels or stays (P=.25) }
PROCEDURE MOVEWUMPUS;
VAR K: INTEGER;
BEGIN
	K := RANDOM(4) + 1;
	IF K <> 4 THEN LOC[2] := CAVE[LOC[2], K];
	IF LOC[2] = LOC[1] THEN
	BEGIN
		WRITELN('TSK TSK TSK- WUMPUS GOT YOU!');
		STATE := -1
	END
END;

PROCEDURE SHOOT;
VAR N, K, ROOM: INTEGER;
BEGIN
	{ The path of the arrow }
	REPEAT
		WRITE('NO. OF ROOMS(1-5)');
		N := ASKNUMBER
	UNTIL (N >= 1) AND (N <= 5);
	K := 1;
	WHILE K <= N DO
	BEGIN
		WRITE('ROOM #');
		PATH[K] := ASKNUMBER;
		IF K > 2 THEN
			IF PATH[K] = PATH[K - 2] THEN
			BEGIN
				WRITELN('ARROWS AREN''T THAT CROOKED - TRY ANOTHER ROOM');
				K := K - 1
			END;
		K := K + 1
	END;
	{ Shoot the arrow: without a tunnel it flies to a random next room }
	ROOM := LOC[1];
	FOR K := 1 TO N DO
	BEGIN
		IF ADJACENT(ROOM, PATH[K]) THEN ROOM := PATH[K]
		ELSE ROOM := CAVE[ROOM, RANDOM(3) + 1];
		IF ROOM = LOC[2] THEN
		BEGIN
			WRITELN('AHA! YOU GOT THE WUMPUS!');
			STATE := 1;
			EXIT
		END;
		IF ROOM = LOC[1] THEN
		BEGIN
			WRITELN('OUCH! ARROW GOT YOU!');
			STATE := -1;
			EXIT
		END
	END;
	WRITELN('MISSED');
	MOVEWUMPUS;
	{ Ammo check }
	ARROWS := ARROWS - 1;
	IF ARROWS <= 0 THEN STATE := -1
END;

PROCEDURE MOVE;
VAR ROOM: INTEGER;
	DONE: BOOLEAN;
BEGIN
	REPEAT
		WRITE('WHERE TO');
		ROOM := ASKNUMBER;
		DONE := FALSE;
		IF (ROOM >= 1) AND (ROOM <= 20) THEN
		BEGIN
			DONE := ADJACENT(LOC[1], ROOM) OR (ROOM = LOC[1]);
			IF NOT DONE THEN WRITE('NOT POSSIBLE -')
		END
	UNTIL DONE;
	{ Hazards; a bat carries you to a random room, and the check starts again }
	REPEAT
		LOC[1] := ROOM;
		DONE := TRUE;
		IF ROOM = LOC[2] THEN
		BEGIN
			WRITELN('...OOPS! BUMPED A WUMPUS!');
			MOVEWUMPUS;
			IF STATE <> 0 THEN EXIT
		END;
		IF (ROOM = LOC[3]) OR (ROOM = LOC[4]) THEN
		BEGIN
			WRITELN('YYYIIIIEEEE . . . FELL IN PIT');
			STATE := -1;
			EXIT
		END;
		IF (ROOM = LOC[5]) OR (ROOM = LOC[6]) THEN
		BEGIN
			WRITELN('ZAP--SUPER BAT SNATCH! ELSEWHEREVILLE FOR YOU!');
			ROOM := RANDOM(20) + 1;
			DONE := FALSE
		END
	UNTIL DONE
END;

BEGIN
	WRITE('INSTRUCTIONS (Y-N)');
	IF ASK <> 'N' THEN INSTRUCTIONS;
	PLACE;
	REPEAT
		ARROWS := 5;
		STATE := 0;
		WRITELN('HUNT THE WUMPUS');
		REPEAT
			WARNINGS;
			IF CHOOSE = 'S' THEN SHOOT ELSE MOVE
		UNTIL STATE <> 0;
		IF STATE > 0 THEN WRITELN('HEE HEE HEE - THE WUMPUS''LL GETCHA NEXT TIME!!')
		ELSE WRITELN('HA HA HA - YOU LOSE!');
		LOC := SAVED;
		WRITE('SAME SET-UP (Y-N)');
	UNTIL ASK <> 'Y'
END.
