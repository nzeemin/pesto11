var A: array[1..5] of Integer; I: Integer; S: string[10];
begin
  {$R+}
  for I := 1 to 5 do A[I] := I;
  S[0] := Chr(3); S[1] := 'x';
  I := 10; S[I] := 'y';
  WriteLn('in range ', A[5], S[1], Ord(S[0]));
  I := 6;
  A[I] := 0;
  WriteLn('never')
end.
