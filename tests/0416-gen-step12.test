=== SOURCE ============================================================
program Step12;
var I, J: Integer; C: Char; X, Y: Real; P: ^Integer;
  A: array[1..10] of Integer; S: array[1..6] of Char;
begin
  case I of
    1: J := 10; 2: J := 20; 3, 4: J := 34; 5..7: J := 57; 9: J := 90; 10: J := 100
  else J := -1
  end;
  case I of
    -100: J := 1; 0: J := 2; 1000..1010: J := 3
  end;
  case C of
    'a'..'c': J := 1; 'x': J := 2
  end;
  P^ := 5; P^ := P^ + I;
  A[I] := A[J]; A[I + 1] := A[J * 2];
  X := 0; X := 2.5; Y := X;
  ReadLn(I);
  Write(S)
end.
