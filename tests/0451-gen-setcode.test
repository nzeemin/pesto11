OPTIONS = -q
=== SOURCE ============================================================
type Digits = set of '0'..'9';
var S, T: set of Char; D: Digits; C: Char; B: Boolean;
procedure P(X: Digits);
begin
  D := X
end;
begin
  S := ['a'..'z', C];
  T := S - ['x'];
  D := ['1', '3'];
  B := (C in S) and (C in D) and (C in ['a', 'c'..'f', 'k', 'm', 'p', 'r'..'t', 'w']);
  B := (S = T) or (D <= ['0'..'5']);
  P(D);
  P(['7'])
end.
