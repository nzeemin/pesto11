;#####################################################################
;## FTOA
;## Need FDIG7
; Real -> текст по форматам Write: без ширины -- 14 символов #.######E+##;
; R:n -- плавающий, 1..6 цифр после точки; R:n:m -- фиксированный, m = 0..24.
; Вход: Real на стеке, R1 = ширина (-1 -- нет), R2 = знаков после точки (-1 -- нет).
; Выход: R0 = строка (байт длины и символы) в FTOA$S, Real снят. Портит: R1-R4.
FTOA:
	MOV	(SP)+, FTOA$R
	MOV	R1, FTOA$W
	MOV	R2, FTOA$M
	CLR	FTOA$N		; знак
	TST	(SP)
	BPL	1$
	BIC	#100000, (SP)
	INC	FTOA$N
1$:	CALL	FDIG7
	CMPB	FDIG$D, #'0	; ноль печатается без минуса
	BNE	2$
	CLR	FTOA$N
2$:	MOV	#FTOA$S+1, R4	; куда пишется текст
	MOV	FTOA$M, R2
	CMP	R2, #24.
	BHI	20$		; m не задано или вне 0..24: плавающий формат
	TST	FTOA$W
	BMI	20$
; Фиксированный формат: значащих цифр до m-го знака после точки -- E + 1 + m
	MOV	FDIG$E, R0
	ADD	R2, R0
	INC	R0
	CMP	R0, #7
	BGE	32$		; все 7 цифр видны, округлять не нужно
	TST	R0
	BGT	31$
	BLT	30$
	CMPB	FDIG$D, #'5	; ровно на границе: 10^-m или 0
	BLO	30$
	MOV	#FDIG$D, R3
	MOVB	#'1, (R3)+
	MOV	#6, R1
3$:	MOVB	#'0, (R3)+
	SOB	R1, 3$
	MOV	R2, FDIG$E
	NEG	FDIG$E
	BR	32$
30$:	MOV	#FDIG$D, R3	; меньше половины последнего знака: 0
	MOV	#7, R1
4$:	MOVB	#'0, (R3)+
	SOB	R1, 4$
	CLR	FDIG$E
	CLR	FTOA$N
	BR	32$
31$:	CALL	FRNDG
32$:	TST	FTOA$N
	BEQ	33$
	MOVB	#'-, (R4)+
33$:	MOV	FDIG$E, R1
	BGE	34$
	MOVB	#'0, (R4)+	; целой части нет
	BR	36$
34$:	CLR	R3		; цифры целой части: индексы 0..E
35$:	CALL	FDGT$
	MOVB	R0, (R4)+
	INC	R3
	CMP	R3, R1
	BLE	35$
36$:	TST	R2
	BEQ	50$
	MOVB	#'., (R4)+
	MOV	FDIG$E, R3
	INC	R3		; первая цифра после точки
37$:	CALL	FDGT$
	MOVB	R0, (R4)+
	INC	R3
	SOB	R2, 37$
	BR	50$
; Плавающий формат
20$:	MOV	FTOA$W, R1
	BPL	21$
	MOV	#6, R2		; Write(R): 6 цифр после точки, место под знак, поле 14
	MOV	#14., FTOA$W
	MOVB	#40, (R4)
	TST	FTOA$N
	BEQ	22$
	MOVB	#'-, (R4)
22$:	INC	R4
	BR	23$
21$:	MOV	R1, R2		; R:n: n - 6 цифр после точки (n - 7 с минусом), 1..6
	SUB	#6, R2
	SUB	FTOA$N, R2
	CMP	R2, #1
	BGE	24$
	MOV	#1, R2
24$:	CMP	R2, #6
	BLE	25$
	MOV	#6, R2
25$:	TST	FTOA$N
	BEQ	23$
	MOVB	#'-, (R4)+
23$:	MOV	R2, R0
	INC	R0
	CALL	FRNDG		; округление до 1 + R2 цифр
	MOVB	FDIG$D, (R4)+
	MOVB	#'., (R4)+
	MOV	#FDIG$D+1, R3
26$:	MOVB	(R3)+, (R4)+
	SOB	R2, 26$
	MOVB	#'E, (R4)+
	MOVB	#'+, (R4)+
	MOV	FDIG$E, R1
	BPL	27$
	MOVB	#'-, -1(R4)
	NEG	R1
27$:	CLR	R0
	DIV	#10., R0
	ADD	#'0, R0
	MOVB	R0, (R4)+
	ADD	#'0, R1
	MOVB	R1, (R4)+
; Выравнивание вправо по ширине
50$:	MOV	R4, R1
	SUB	#FTOA$S+1, R1	; длина текста
	MOV	FTOA$W, R2
	CMP	R2, #255.
	BLE	51$
	MOV	#255., R2
51$:	SUB	R1, R2		; сколько пробелов слева
	BLE	54$
	MOV	R4, R3		; сдвиг текста вправо
	ADD	R2, R4
	MOV	R4, R0
52$:	MOVB	-(R3), -(R0)
	SOB	R1, 52$
53$:	MOVB	#40, -(R0)
	SOB	R2, 53$
54$:	SUB	#FTOA$S+1, R4
	MOVB	R4, FTOA$S	; длина
	MOV	#FTOA$S, R0
	JMP	@FTOA$R
; Цифра с индексом R3 (вне 0..6 -- '0') в R0
FDGT$:	MOVB	#'0, R0
	TST	R3
	BLT	1$
	CMP	R3, #6
	BGT	1$
	MOVB	FDIG$D(R3), R0
1$:	RETURN
; Округление цифр FDIG$D до R0 цифр (1..6); перенос из старшей цифры увеличивает порядок.
; Портит: R1.
FRNDG:	CMP	R0, #7
	BGE	3$
	CMPB	FDIG$D(R0), #'5
	BLO	2$
	MOV	R0, R1
1$:	DEC	R1
	BLT	4$
	INCB	FDIG$D(R1)
	CMPB	FDIG$D(R1), #'9+1
	BLO	2$
	MOVB	#'0, FDIG$D(R1)
	BR	1$
4$:	MOVB	#'1, FDIG$D	; 9.99..9 -> 10.0..0
	INC	FDIG$E
2$:	MOV	R0, R1		; цифры после округлённой -- нули
5$:	CMP	R1, #7
	BGE	3$
	MOVB	#'0, FDIG$D(R1)
	INC	R1
	BR	5$
3$:	RETURN
FTOA$R:	.WORD	0
FTOA$W:	.WORD	0
FTOA$M:	.WORD	0
FTOA$N:	.WORD	0
FTOA$S:	.BLKB	256.

;#####################################################################
;## WRREAL
;## Need FTOA
;## Need WRSTR
; Write(R), Write(R:n), Write(R:n:m).
; Вход: Real на стеке, R1 = ширина (-1), R2 = знаков после точки (-1). Real снимается.
WRREAL:
	MOV	(SP)+, WRRE$R
	CALL	FTOA
	CALL	WRSTR
	JMP	@WRRE$R
WRRE$R:	.WORD	0

;#####################################################################
;## STRR
;## Need FTOA
;## Need STCP
; Str(R:n:m, S).
; Вход: Real на стеке, R0 = строка, R1 = ширина (-1), R2 = знаков (-1), R3 = макс. длина.
STRR:
	MOV	(SP)+, STRR$R
	MOV	R0, STRR$D
	MOV	R3, STRR$M
	CALL	FTOA
	MOV	STRR$D, R1
	MOV	STRR$M, R2
	CALL	STCP
	JMP	@STRR$R
STRR$R:	.WORD	0
STRR$D:	.WORD	0
STRR$M:	.WORD	0

;#####################################################################
;## VALR
;## Need FSCAL
;## Need LTOF
; Val(S, R, Code) для Real: [знак] цифры [. цифры] [E [знак] цифры], без пробелов.
; Вход: R0 = строка. Выход: на стеке Real, над ним позиция ошибки (0 -- нет). Портит: R0-R4.
VALR:
	MOV	(SP)+, VALR$R
	CLR	VALR$H		; мантисса, до 9 цифр
	CLR	VALR$L
	CLR	VALR$X		; десятичный порядок
	CLR	VALR$S		; знак
	CLR	R2
	BISB	(R0)+, R2	; осталось символов
	MOV	#1, R1		; позиция текущего символа
	TST	R2
	BEQ	87$
	CMPB	(R0), #'-
	BNE	1$
	INC	VALR$S
	BR	2$
87$:	JMP	90$		; дальний переход на ошибку
1$:	CMPB	(R0), #'+
	BNE	3$
2$:	INC	R0
	INC	R1
	DEC	R2
	BEQ	87$
3$:	CLR	R3		; цифры целой части, хотя бы одна
4$:	TST	R2
	BEQ	10$
	MOVB	(R0), R4
	SUB	#'0, R4
	CMP	R4, #9.
	BHI	10$
	CALL	VALR$A
	INC	R3
	INC	R0
	INC	R1
	DEC	R2
	BR	4$
10$:	TST	R3
	BEQ	87$
	TST	R2
	BEQ	30$
	CMPB	(R0), #'.
	BNE	20$
	INC	R0
	INC	R1
	DEC	R2
	CLR	R3		; цифры после точки, хотя бы одна
11$:	TST	R2
	BEQ	12$
	MOVB	(R0), R4
	SUB	#'0, R4
	CMP	R4, #9.
	BHI	12$
	CALL	VALR$A
	DEC	VALR$X
	INC	R3
	INC	R0
	INC	R1
	DEC	R2
	BR	11$
12$:	TST	R3
	BEQ	90$
	TST	R2
	BEQ	30$
20$:	CMPB	(R0), #'E
	BEQ	21$
	CMPB	(R0), #'e
	BNE	90$
21$:	INC	R0
	INC	R1
	DEC	R2
	BEQ	90$
	CLR	-(SP)		; знак порядка
	CMPB	(R0), #'-
	BNE	22$
	INC	(SP)
	BR	23$
22$:	CMPB	(R0), #'+
	BNE	24$
23$:	INC	R0
	INC	R1
	DEC	R2
	BEQ	89$
24$:	CLR	R3		; порядок
	MOV	R1, VALR$P	; позиция первой цифры порядка
25$:	TST	R2
	BEQ	26$
	MOVB	(R0), R4
	SUB	#'0, R4
	CMP	R4, #9.
	BHI	26$
	CMP	R3, #1000.
	BHI	89$		; слишком большой порядок
	MUL	#10., R3
	ADD	R4, R3
	INC	R0
	INC	R1
	DEC	R2
	BR	25$
26$:	CMP	R1, VALR$P
	BEQ	89$		; нет цифр порядка
	TST	(SP)+
	BEQ	27$
	NEG	R3
27$:	ADD	R3, VALR$X
	TST	R2
	BNE	90$		; лишние символы в конце
30$:	MOV	R1, VALR$P	; позиция для ошибки переполнения
	MOV	VALR$H, R0
	MOV	VALR$L, R1
	CALL	LTOF		; мантисса как Real
	MOV	VALR$X, R0
	BEQ	35$
	TST	(SP)
	BEQ	35$		; 0 при любом порядке
	CMP	R0, #-63.
	BGE	31$
	CLR	(SP)		; очень маленькое число: 0.0
	CLR	2(SP)
	BR	35$
31$:	MOV	(SP), R1	; переполнение: десятичный порядок результата больше 38
	ASH	#-7, R1
	BIC	#177400, R1
	SUB	#200, R1
	MUL	#77., R1
	ASH	#-8., R1
	ADD	R0, R1
	CMP	R1, #38.
	BGT	91$
	CALL	FSCAL		; мантисса * 10^порядок (потеря значимости даёт 0)
35$:	TST	VALR$S
	BEQ	36$
	TST	(SP)
	BEQ	36$
	ADD	#100000, (SP)	; минус
36$:	CLR	-(SP)		; ошибки нет
	JMP	@VALR$R
91$:	CMP	(SP)+, (SP)+
	MOV	VALR$P, R1
	BR	90$
89$:	TST	(SP)+		; знак порядка
90$:	CLR	-(SP)		; ошибка: Real 0.0, позиция в R1
	CLR	-(SP)
	MOV	R1, -(SP)
	JMP	@VALR$R
; Цифра R4 в мантиссу; если мантисса уже >= 10^8, цифра только увеличивает порядок
VALR$A:	CMP	VALR$H, #2765	; 10^8 = 2765:160400
	BLO	1$
	BHI	2$
	CMP	VALR$L, #160400
	BLO	1$
2$:	INC	VALR$X
	RETURN
1$:	MOV	R0, -(SP)
	MOV	R1, -(SP)
	MOV	VALR$H, R0
	MOV	VALR$L, R1
	ASHC	#1, R0		; M * 2
	MOV	R0, -(SP)
	MOV	R1, -(SP)
	ASHC	#2, R0		; M * 8
	ADD	(SP)+, R1
	ADC	R0
	ADD	(SP)+, R0	; M * 10
	ADD	R4, R1
	ADC	R0		; + цифра
	MOV	R0, VALR$H
	MOV	R1, VALR$L
	MOV	(SP)+, R1
	MOV	(SP)+, R0
	RETURN
VALR$R:	.WORD	0
VALR$H:	.WORD	0
VALR$L:	.WORD	0
VALR$X:	.WORD	0
VALR$S:	.WORD	0
VALR$P:	.WORD	0

;#####################################################################
;## FRND
; Генератор псевдо-случайных чисел.
; На основе кода процедуры RAN из реализации Бейсик Вильнюс для УКНЦ.
; На входе: (SP) адрес возврата
;           (SP+2)(SP+4) = управляющий параметр:
;   >0: получить очередное псевдо-случайное число
;   <0: задаёт начальное значение
;   0: вернуть предыдущее псевдо-случайное число
; Результат: (SP)(SP+2) псевдо-случайное число в диапазоне [0,1)
FRND:
	MOV	R5, FRND$5	; R5 -- указатель кадра Pesto/11
	MOV	(SP)+, FRND$X+2	; сохраняем адрес для выхода
	TST	(SP)		; проверяем старшее слово параметра
	BEQ	26$		; параметр 0 => отдать текущее значение
	BPL	1$		; > 0 => генерация следующего
; Параметр < 0 ? инициализация
	CLR	RNDSAV		; сбросить сохранённое значение
	MOV	#040311, FRND$I	; начальное состояние = PI/2
	MOV	#007733, FRND$I+2
1$:	MOV	#FRND$I, R2	; адрес состояния (старшее слово)
	MOV	#FRND$I+2, R3	; адрес состояния (младшее слово)
	MOV	(R2), R0	; загрузить текущее состояние
	MOV	(R3), R1
	BEQ	21$		; если ноль, особая инициализация
; state = (state * 3 + 1) mod 2^31
	ASL	R1		; умножить на 2
	ROL	R0
	ADD	(R2), R0	; state*3
	ADD	(R3), R1
	ADC	R0
	ADD	(R3), R0	; + state (младшее слово) -> state*3 + 1
	BPL	2$		; если нет переполнения знакового бита
	ADD	#100000,R0	; инвертировать знаковый бит
;RAN2:
2$:	MOV	R0, (R2)	; сохранить новое состояние в III
	MOV	R1, (R3)
	MOV	#201,R2		; начальная экспонента = 129.
4$:	ASL	R1		; нормализация:
	ROL	R0		; сдвигать мантиссу, пока старшая единица не выйдет в C
	BCS	23$
	DEC	R2		; уменьшать экспоненту
	BR	4$
;RAN3: Упаковка в формат float: знак = 0, экспонента = R2, мантисса из старших битов R0,R1
23$:	CLRB	R1
	BISB	R0,R1
	SWAB	R1
	CLRB	R0
	BISB	R2,R0
	SWAB	R0
	ROR	R0		; знак = 0
	ROR	R1
	BR	25$
;RAN1: Если состояние обнулилось (например, при инициализации нулём), используем (1,3)
21$:	MOV	#3,R1
	INC	R0
	BR	2$
;RAN5:
25$:	TST	RNDSAV		; RNDSAV ещё не заполнено? первый вызов после инициализации
	BNE	27$		; не ноль, значит уже было ? просто сохраняем новое
; Первое после инициализации: преобразуем целое состояние в float [0,1)
	MOV	R1,-(SP)	; поместить полученное число (R0,R1) на стек
	MOV	R0,-(SP)
	CLR	R5		; R5 = 0 (счётчик масштабирования)
	MOV	6(SP),-(SP)	; Дублируем число для операций
	MOV	6(SP),-(SP)
	BIC	#100000,(SP)	; сбросить знак (работаем с положительным числом)
; Цикл приведения в диапазон [0,1)
13$:	CMP	#040200,(SP)	; сравнить старшее слово с 1.0
	BGT	11$		; если > 1.0 -> уменьшить
	DEC	R5		; иначе увеличиваем счётчик
	BGE	15$		; если R5 >= 0, выходим (достигли нужного интервала)
; Число < 1.0, но R5 < 0 -> нужно делить на 10.0
	CLR	-(SP)		; константа 10.0 младшее слово
	MOV	#041040,-(SP)	; константа 10.0 старшее слово
	FDIV	SP		; разделить число на 10.0
	BR	13$		; продолжить цикл
11$:	MOV	SP,R2
	MOV	(R2)+,6(R2)	; копирование числа
	MOV	(R2)+,6(R2)
	INC	R5
	BLE	15$
	CLR	-(SP)		; константа 10.0 младшее слово
	MOV	#041040,-(SP)	; константа 10.0 старшее слово
	FMUL	SP		; умножить на 10.0
	BR	13$		; продолжить цикл
;
15$:	ADD	#4,SP		; удаляем временные копии числа
; Теперь требуется ещё отбросить целую часть
	CLR	-(SP)		; константа 10.0 младшее слово
	MOV	#041040,-(SP)	; константа 10.0 старшее слово
	FDIV	SP		; деление на 10.0
	CLR	-(SP)		; положить 1.0 младшее слово
	MOV	#040200,-(SP)	; положить 1.0 старшее слово
	FADD	SP		; сложить с 1.0
	FSUB	SP		; вычитание
;
17$:	BIC	#100000,(SP)	; сбросить знак результата
	MOV	SP,R2
	MOV	(R2)+, FRND$I	; сохранить результат в III
	MOV	(R2)+, FRND$I+2
	MOV	-(R2), R1	; восстановить R0,R1
	MOV	-(R2), R0
;RAN7:
27$:	MOV	R1, RNDSAV+2	; сохранить сгенерированное значение
	MOV	R0, RNDSAV
;RAN6:
26$:	MOV	RNDSAV+2, 2(SP)	; заменяем параметр на стеке на результат
	MOV	RNDSAV, (SP)
	MOV	FRND$5, R5
FRND$X:	JMP	@#000000	; возврат, адрес подставляется в начале
;
FRND$I:	.WORD	040101, 027076	; III: Рабочие ячейки FRND
RNDSAV:	.WORD	040101, 027076	; Предыдущее псевдо-случайное число: старшее, младшее
FRND$5:	.WORD	0

;#####################################################################
;## FSQR
;## Need RTERR
; Квадратный корень из плавающего числа (float).
; На основе кода процедуры SQRG из реализации Бейсик Вильнюс для УКНЦ.
; Для отрицательных чисел выдаётся ошибка; для 0.0 результат 0.0.
; Алгоритм: итерационный метод Ньютона с начальным приближением
; На входе: (SP) - адрес возврата
;           (SP+2)(SP+4) - число с плавающей точкой (старшее слово, младшее слово)
; На выходе: (SP)(SP+2) - результат
FSQR:
	MOV	(SP)+, FSQR$X+2	; адрес возврата
	MOV	SP,R4		; R4 указывает на вершину стека (временный указатель)
	MOV	(R4), R1	; R1 = старшее слово аргумента
	BMI	FSQR$K		; если отрицательное - ошибка
	BEQ	0$		; если ноль - результат 0
	MOV	#3,-(SP)	; счётчик итераций (3) на стек
	ASR	R1		; экспоненту делим на 2 (приближение)
	ADD	#20100, R1	; коррекция мантиссы (начальное приближение)
	CLR	-(SP)		; младшее слово приближения = 0
	MOV	R1, -(SP)	; старшее слово приближения на стек
	CLR	-(SP)		; младшее слово аргумента (0)
	MOV	(R4), -(SP)	; старшее слово аргумента (копия)
	CLR	-(SP)		; младшее слово для операции
	MOV	R1, -(SP)	; старшее слово приближения (второй операнд)
3$:	FDIV	SP		; деление: аргумент / приближение
	FADD	SP		; сложение: (приближение + результат деления)
	SUB	#200, (SP)	; поделить результат на 2
	DEC	4(SP)		; уменьшить счётчик итераций
	BEQ	2$		; если счётчик = 0, выходим
	MOV	10(SP), -(SP)	; иначе скопировать тек.приближение для следующей итерации
	MOV	10(SP), -(SP)
	MOV	6(SP), -(SP)
	MOV	6(SP), -(SP)
	BR	3$		; повторить
2$:	MOV	(SP)+, R0	; снять старшее слово результата
	MOV	(SP)+, R1	; снять младшее слово результата
	TST	(SP)+		; удалить счётчик итераций
	BR	FSQR$E		; получили результат, выходим
0$:	CLR	R0		; результат 0.0
	CLR	R1
; R0,R1 - старшее и младшее слова результата
FSQR$E:	MOV	R0, (SP)	; заменяем старшее слово результатом
	MOV	R1, 2(SP)	; заменяем младшее слово
FSQR$X:	JMP	@#000000	; возврат, адрес подставляется в начале
;
FSQR$K:	MOV	FSQR$X+2, -(SP)	; откуда вызвали
	MOV	#3, R0		; ошибка 03: Sqrt от отрицательного
	JMP	RTERR

;#####################################################################
;## FCOS
;## Need FSIN
; Вычисление cos(X) для плавающего числа (float).
; На основе кода процедуры KOS из реализации Бейсик Вильнюс для УКНЦ.
; Реализуется через вычисление sin: cos(x) = sin(x + PI/2)
; На входе: (SP) - адрес возврата
;           (SP+2)(SP+4) - число с плавающей точкой (старшее слово, младшее слово)
; На выходе: (SP)(SP+2) - результат
FCOS:
	MOV	(SP)+, 10$+2	; адрес возврата
	MOV	#007733,-(SP)	; младшее слово PI/2
	MOV	#040311,-(SP)	; старшее слово PI/2
	FADD	SP		; сложение: аргумент + PI/2
10$:	MOV	#000000, -(SP)	; адрес возврата
	JMP	FSIN		; дальше через вычисление синуса

;#####################################################################
;## FSIN
;## Need FINT
; Вычисление sin(X) для плавающего числа (float).
; На основе кода процедуры SING из реализации Бейсик Вильнюс для УКНЦ.
; Алгоритм:
;   1. Приведение аргумента к диапазону [0, PI/2] путём деления на PI/2,
;      выделения целой части (квадранта) и взятия дробной части.
;   2. Приведённый аргумент (в [0, PI/2]) раскладывается в полином
;      с коэффициентами из таблицы FSIN$T.
;   3. Знак результата корректируется в зависимости от квадранта.
; Полином вычисляется по схеме Горнера:
;   sin(x) ~= t * (a1 + t^2*(a2 + t^2*(a3 + t^2*(a4 + t^2*a5))))
; Коэффициенты получены из разложения Маклорена sin(x) с подстановкой x = (PI/2)*t:
;   a1 = PI/2 ~= 1.57079632679
;   a2 = -(PI/2)^3 / 3! ~= -0.645964
;   a3 = (PI/2)^5 / 5! ~= 0.0796897
;   a4 = -(PI/2)^7 / 7! ~= -0.00467377
;   a5 = (PI/2)^9 / 9! ~= 0.000151484
; На входе: (SP) - адрес возврата
;           (SP+2)(SP+4) - число с плавающей точкой (старшее слово, младшее слово)
; На выходе: (SP)(SP+2) - результат
FSIN:
	MOV	(SP)+, FSIN$X+2	; адрес возврата
; На стеке: (SP)(SP+2) - исходное число
	CLR	-(SP)		; выделить место под хранение знака
	MOV	4(SP),-(SP)	; скопировать аргумент (старшее)
	MOV	4(SP),-(SP)	; скопировать аргумент (младшее)
	ASL	(SP)		; выдвигаем знак в C
	ROR	4(SP)		; сохраняем знак в 4(SP)
	ROR	(SP)		; сдвигаем старшее слово обратно без знака
	MOV	#7733,-(SP)	; младшее слово 2/PI (константа)
	MOV	#40711,-(SP)	; старшее слово 2/PI
	FDIV	SP		; деление: (2x) / (2/PI) = x * PI
; На самом деле это приведение: вычисляем t = (2x)/PI, затем выделяем целую часть
; на стеке: (SP)(SP+2) = t, (SP+4) = знак, (SP+6)(SP+10) = исх.число
	MOV	2(SP),-(SP)	; копировать результат (t)
	MOV	2(SP),-(SP)
	CALL	FINT		; отбросить дробную часть -> целое число
	FSUB	SP		; вычесть t, получаем дробную часть
; на стеке: дробная часть, (SP+4)(SP+6) = t, (SP+10) = знак, (SP+12)(SP+14) = исх.число
; Проверить, есть ли дробная часть
	TST	(SP)		; старшее слово 0 ?
	BEQ	12$		; нет дробной чати => на завершение
	INCB	1(SP)		; увеличение экспоненты - умножение числа на 4
	MOV	2(SP),-(SP)	; скопировать
	MOV	2(SP),-(SP)
	CALL	FINT		; опять отбросить дробную часть
	BIS	(SP),10(SP)	; объединение флагов ??
	FSUB	SP		; вычесть
	TSTB	4(SP)		; проверяем байт флагов
	BEQ	3$
	ADD	#100000,(SP)	; инвертировать знак
	CLR	-(SP)		; константа 1.0
	MOV	#040200,-(SP)	;
	FADD	SP		; сложение с 1.0
3$:	ASRB	5(SP)		; сдвигаем байт флагов
	BCC	8$
	ADD	#100000,(SP)	; если бит = 1, изменить знак
; Начало полиномиального разложения
; на стеке: (SP)(SP+2) = t, (SP+4) = знак, (SP+6)(SP+10) = исх.число
8$:	MOV	2(SP),-(SP)	; копируем значение
	MOV	2(SP),-(SP)
	MOV	2(SP),-(SP)	; копируем значение
	MOV	2(SP),-(SP)
	FMUL	SP		; умножение (возведение в квадрат) = t^2
; на стеке: (SP)(SP+2) = t^2, (SP+4)(SP+6) = t, (SP+10) = знак, (SP+12)(SP+14) = исх.число
	MOV	(SP)+,R0	; снять t^2 старшее слово
	MOV	(SP)+,R1	; снять t^2 младшее слово
	MOV	#FSIN$T,R2	; адрес таблицы коэффициентов
	MOV	#4,R3		; количество итераций
	MOV	(R2)+,-(SP)	; коэфф. a5 младшее слово
	MOV	(R2)+,-(SP)	; коэфф. a5 старшее слово
; на стеке: (SP)(SP+2) = сумма, (SP+4)(SP+6) = t, (SP+10) = знак, (SP+12)(SP+14) = исх.число
9$:	MOV	R1,-(SP)	; положить t^2 младшее слово
	MOV	R0,-(SP)	; положить t^2 старшее слово
	FMUL	SP		; умножить на t^2
	MOV	(R2)+,-(SP)	; коэфф. младшее слово
	MOV	(R2)+,-(SP)	; коэфф. старшее слово
	FADD	SP		; сложить с коэфф.
	SOB	R3, 9$		; повторяем
	FMUL	SP		; умножить на t
; Получен результат, осталось сделать коррекцию знака
; на стеке: (SP)(SP+2) = результат, (SP+4) = знак, (SP+6)(SP+10) = исх.число
12$:	TST	4(SP)		; проверить сохранённый знак
	BGE	14$
	ADD	#100000,(SP)	; изменить знак результата
14$:	MOV	(SP)+,4(SP)	; переместить результат на место исходного аргумента
	MOV	(SP)+,4(SP)
	TST	(SP)+		; подчищаем стек
FSIN$X:	JMP	@#000000	; возврат
;
; Таблица коэффициентов для полиномиальной аппроксимации синуса/косинуса
FSIN$T:	.WORD	153672, 035036 	; a5 (~= 0.000151484)
	.WORD	023143, 136231 	; a4 (~= -0.00467377)
	.WORD	032130, 037243 	; a3 (~= 0.0796897)
	.WORD	056741, 140045 	; a2 (~= -0.645964)
	.WORD	007733, 040311 	; a1 = PI/2 (~= 1.5707963)

;#####################################################################
;## FATN
; Вычисление арктангенса числа с плавающей точкой.
; На основе кода процедуры ATANG из реализации Бейсик Вильнюс для УКНЦ.
; Алгоритм:
;   1. Запоминаем знак аргумента, работаем с |x|.
;   2. Если |x| > 1, используем тождество arctg(x) = PI/2 - arctg(1/x).
;   3. Если |x| > tan(PI/12) ~= 0.267949, используем тождество
;      arctg(x) = PI/4 + arctg((x-1)/(x+1)), где x >= 0;
;      это приводит аргумент к интервалу [0, tan(PI/12)].
;   4. Для малого аргумента (|x| <= tan(PI/12)) вычисляем полином:
;        arctg(x) ~= x * (c1 + x^2*(c2 + x^2*(c3 + x^2*(c4 + x^2*c5))))
;      где коэффициенты c1..c5 подобраны для минимизации ошибки на данном интервале
;      (c1 = 1, c2 = -1/3, c3 = 0.199977, c4 = -0.141957, c5 = 0.0963035).
;   5. Корректируем знак и добавляем PI/4 или PI/2, если нужно.
; На входе: (SP) - адрес возврата
;           (SP+2)(SP+4) - число с плавающей точкой (старшее слово, младшее слово)
; На выходе: (SP)(SP+2) - результат
FATN:
; На стеке только (SP)(SP+2) = x
	CLR	-(SP)		; выделить место под временные переменные (5 слов)
	CLR	-(SP)
	CLR	-(SP)
	CLR	-(SP)
	CLR	-(SP)
; На стеке: 5 пустых слов, (SP+14)(SP+16) x
	MOV	16(SP),-(SP)	; скопировать младшее слово аргумента (лежит на SP+16)
	MOV	16(SP),-(SP)	; скопировать старшее слово аргумента
; На стеке: (SP)(SP+2) x, 5 пустых слов, (SP+20)(SP+22) x
	BGE	1$		; если аргумент >= 0, то переходим
	ADD	#100000,(SP)	; инвертировать знак числа - сделать положительным
	INC	14(SP)		; увеличить флаг знака: запомнить, x был отрицательным
;AT1:
1$:	CMP	(SP),#40200	; сравнить старшее слово аргумента с 1.0
	BCS	3$		; если аргумент < 1.0, перейти (не требуется деление)
	BGT	2$		; если > 1.0 => переход
	TST	2(SP)		; x = 1.0 ? проверить младшее слово, должно быть 0
	BEQ	3$		; да это 1.0 => переход
;AT2:
2$:	MOV	#140311,4(SP)	; старшее слово константы -PI/2
	MOV	#7733,6(SP)	; младшее слово -PI/2
	DEC	14(SP)		; уменьшить флаг знака
	MOV	2(SP),-(SP)	; скопировать младшее слово
	MOV	2(SP),-(SP)	; скопировать старшее слово
	MOV	#40200,4(SP)	; положить константу 1.0
	CLR	6(SP)		; младшее слово 1.0
	FDIV	SP		; разделить 1.0 на x
;AT3: На стеке: (SP)(SP+2) 1/x, (SP+4)(SP+6) -PI/2
3$:	MOV	2(SP),-(SP)	; скопировать аргумент старшее слово
	MOV	2(SP),-(SP)	; скопировать младшее слово
	CLR	4(SP)		; обнулить временное слово
	CLR	6(SP)		; обнулить старшее слово
	CMP	(SP),#37611	; сравнить старшее слово аргумента с константой tan(PI/12)
	BCS	5$		; если аргумент < tan(PI/12), перейти к полиному
	BHI	4$		; если >, перейти
	CMP	2(SP),#30243	; если равен, проверить младшее слово, сравнив с tan(PI/12)
	BLOS	5$		; если <=, то малый аргумент
; Здесь x > tan(PI/12), поэтому используется тождество arctg(x) = PI/6 + arctg((x-1)/(x+1))
;AT4: Вычисляем (x-1)/(x+1) и затем arctg от него
4$:	MOV	#40006,4(SP)	; константа 0.523599 ~= PI/6
	MOV	#5222,6(SP)	; младшее слово константы
	MOV	(SP),R0		; старшее слово x
	MOV	2(SP),R1	; младшее слово x
	MOV	#131727,-(SP)	; константа -1.73205 ~= -sqrt(3), младшее слово
	MOV	#140335,-(SP)	; константа -1.73205 старшее слово
	MOV	R1,-(SP)	; младшее слово x
	MOV	R0,-(SP)	; старшее слово x
	CLR	-(SP)		; константа 1.0 младшее слово
	MOV	#40200,-(SP)	; константа 1.0 старшее
	MOV	#131727,-(SP)	; константа -1.73205 ~= -sqrt(3), младшее слово
	MOV	#40335,-(SP)	; константа -1.73205 старшее слово
	MOV	R1,-(SP)	; младшее слово x
	MOV	R0,-(SP)	; старшее слово x
	FMUL	SP		; умножение (вероятно, для вычисления (x-1)/(x+1))
	FSUB	SP		; вычитание
	MOV	(SP)+,12(SP)	; переместить результат (старшее слово) на место (SP+12)
	MOV	(SP)+,12(SP)	; переместить младшее слово
	FSUB	SP		; ещё вычитание
	FDIV	SP		; деление
;AT5: Вычисление полинома
5$:	MOV	(SP),R0		; взять аргумент (уже приведённый к малому), старшее слово
	MOV	2(SP),R1	; младшее слово
	MOV	R1,-(SP)	; дублировать x на стек
	MOV	R0,-(SP)
	MOV	R1,-(SP)	; и ещё раз x на стек
	MOV	R0,-(SP)
	FMUL	SP		; умножение (возведение в квадрат)
;AT7: На стеке: (SP)(SP+2) x^2, (SP+4)(SP+6) x
	MOV	(SP)+,R0	; снять старшее слово x^2
	MOV	(SP)+,R1	; снять младшее слово x^2
	MOV	#FATN$T,R2	; загрузить адрес таблицы коэффициентов
	MOV	#4,R3		; количество итераций
	MOV	(R2)+,-(SP)	; коэфф. c5 младшее слово
	MOV	(R2)+,-(SP)	; коэфф. c5 старшее слово
;AT9: На стеке: (SP)(SP+2) сумма
9$:	MOV	R1,-(SP)	; положить x^2 младшее слово
	MOV	R0,-(SP)	; положить x^2 старшее слово
	FMUL	SP		; умножить на x^2
	MOV	(R2)+,-(SP)	; коэфф. младшее слово
	MOV	(R2)+,-(SP)	; коэфф. старшее слово
	FADD	SP		; сложить с коэфф.
	SOB	R3, 9$		; повторяем
	FMUL	SP		; умножить на x
	FADD	SP		; ??
	FADD	SP		; ??
	TST	10(SP)		; проверить флаг
	BEQ	10$		; если 0, пропустить
	ADD	#100000,(SP)	; изменить знак результата
10$:	FADD	SP		; ??
;SINGI:
	MOV	(SP)+,6(SP)	; переместить результат на место исходного аргумента
	MOV	(SP)+,6(SP)
	TST	(SP)+		; подчищаем стек
	RETURN			; возврат
;
; Таблица коэффициентов для полинома арктангенса
FATN$T:	.WORD	035302, 037305	; c5 = 0.0963035
	.WORD	056514, 137421	; c4 = -0.141957
	.WORD	143333, 037514	; c3 = 0.199977
	.WORD	125244, 137652	; c2 = -1/3 ~= -0.333333
	.WORD	000000, 040200	; c1 = 1.0

;#####################################################################
;## FEXP
;## Need FTOI
;## Need ITOF
;## Need RTERR
; Экспоненциальная функция e^x.
; На входе: (SP) - адрес возврата
;           (SP+2)(SP+4) - число с плавающей точкой (старшее слово, младшее слово)
; На выходе: (SP)(SP+2) - результат
; На основе кода процедуры EXPG из реализации Бейсик Вильнюс для УКНЦ.
FEXP:
	MOV	(SP)+, FEXP$X+2	; сохранить адрес возврата
; На стеке: (SP)(SP+2) - аргумент x (старшее, младшее слово)
	MOV	SP, R4		; R4 -> аргумент x
	MOV	@R4, R0		; R0 = старшее слово x
	BGT	FEXP1		; x > 0 -> проверить переполнение
	CMP	R0, #141662	; x < 0: порог -7.0
	BLOS	FEXP2		; x >= -7.0 -> обычное вычисление
	CLR	R0		; иначе e^x = 0
	CLR	R1
	BR	FEXPI
FEXP1:	CMP	R0, #41660	; x > 0: порог +7.0
	BHI	FEXPK		; x > +7.0 -> переполнение
FEXP2:	ASL	R0		; старшее слово *2 (выделение целой части)
	CMP	R0, #63000	; если меньше порога, x мал -> e^x ~ 1.0
	BCS	FEXP3
; вычисление e^x = 2^k * e^r
	TST	-(SP)		; выравнивание стека
	CLR	-(SP)		; зарезервировать слово
	MOV	#40200, -(SP)	; константа 1.0
	MOV	2(R4), -(SP)	; копия младшего слова x
	MOV	@R4, -(SP)		; копия старшего слова x
	MOV	2(R4), -(SP)	; дублировать x
	MOV	@R4, -(SP)
	MOV	#125073, -(SP)	; EX4: положить log2(e)
	MOV	#40270, -(SP)
	FMUL	SP		; MLR: x * log2(e)
	CALL	FTOI		; RI: целое k в R0
	MOV	R0, -(SP)		; положить k на стек (как RI)
	MOV	@SP, 12(SP)	; EX5: сохранить k
	MOV	(SP)+, R0		; IR: снять k в R0
	CALL	ITOF		; IR: k как float на стеке
	MOV	#125073, -(SP)	; EX4: log2(e)
	MOV	#40270, -(SP)
	FDIV	SP		; DVR
	FSUB	SP		; SUB: r = x - k*ln2
; EX6: подготовка к полиному
	ROL	@SP
	ROL	R0
	SUB	#400, @SP
	BLOS	FEXP10		; малый r -> e^r ~ 1
	ROR	R0
	ROR	@SP
	MOV	@SP, R0
	MOV	2(SP), R1
	MOV	#36602, -(SP)
	MOV	#141100, -(SP)
	MOV	R1, -(SP)
	MOV	R0, -(SP)
	MOV	#71571, -(SP)
	MOV	#42426, -(SP)
	MOV	#56133, -(SP)
	MOV	#41560, -(SP)
	MOV	R1, -(SP)
	MOV	R0, -(SP)
	MOV	R1, -(SP)
	MOV	R0, -(SP)
	FMUL	SP		; MLR
	FADD	SP		; ADR
	FDIV	SP		; DVR
	FADD	SP		; ADR
	FADD	SP		; ADR
	FDIV	SP		; DVR
	ADD	#100200, @SP	; EX7: коррекция порядка
	FADD	SP		; ADR
	MOV	2(SP), -(SP)	; EX8: копия результата
	MOV	2(SP), -(SP)
	FMUL	SP		; MLR
	BR	FEXP9		; EX9
FEXP10:	CMP	(SP)+, (SP)+
FEXP9:	MOV	(SP)+, R0	; старшее слово результата
	MOV	(SP)+, R1		; младшее слово результата
	MOV	(SP)+, R4		; k
	SWAB	R4
	CLRB	R4
	ASR	R4
	ADD	R4, R0		; масштаб 2^k
	BMI	FEXPK		; переполнение
	BR	FEXPI
FEXP3:	MOV	#40200, R0	; e^x ~ 1.0
	CLR	R1
FEXPI:	MOV	R0, (SP)	; результат в слот аргумента (старшее слово)
	MOV	R1, 2(SP)		; результат (младшее слово)
FEXP$X:	JMP	@#000000	; возврат
FEXPK:	MOV	FEXP$X+2, -(SP)	; переполнение экспоненты
	MOV	#1, R0		; ошибка 01: переполнение Real
	JMP	RTERR

;#####################################################################
;## FLOG
;## Need ITOF
;## Need RTERR
; Натуральный логарифм ln(x).
; На входе: (SP)(SP+2) - аргумент x (float, старшее слово верхнее).
; На выходе: (SP)(SP+2) - результат ln(x).
; Ошибка: если x <= 0.
; На основе кода процедуры ALNG из реализации Бейсик Вильнюс для УКНЦ.
FLOG:
	MOV	(SP)+, FLOG$X+2	; сохранить адрес возврата
	MOV	SP, FLOG$P	; запомнить указатель на аргумент
	CLR	-(SP)		; слово-выравниватель (место R4)
	MOV	SP, R4		; R4 -> вершина стека
	TST	(R4)+		; R4 -> старшее слово x
	CLR	-(SP)		; временная переменная (порядок k)
	MOV	#71030, -(SP)	; константа (младшее слово)
	MOV	#137661, -(SP)	; константа (старшее слово)
	CMP	-(SP), -(SP)	; зарезервировать два слова
	MOV	2(R4), -(SP)	; копия младшего слова x
	MOV	@R4, -(SP)	; копия старшего слова x
	BGT	FLOG2		; x > 0 -> продолжить
	MOV	FLOG$X+2, -(SP)	; x <= 0: ошибка
	MOV	#4, R0		; ошибка 04: Ln от неположительного
	JMP	RTERR
FLOG2:	ASL	@SP		; выделить порядок
	MOVB	1(SP), 14(SP)	; сохранить байт порядка k
	MOVB	#200, 1(SP)	; установить неявную единицу, m в [1,2)
	ROR	@SP		; восстановить мантиссу
	MOV	#2363, -(SP)	; константа (младшее)
	MOV	#40065, -(SP)	; константа (старшее)
	MOV	6(SP), -(SP)	; копия младшего слова m
	MOV	6(SP), -(SP)	; копия старшего слова m
	MOV	#2363, -(SP)	; константа (младшее)
	MOV	#40065, -(SP)	; константа (старшее)
	FSUB	SP		; SUB: m - const
	MOV	(SP)+, 12(SP)	; ALO1: сохранить числитель (старшее)
	MOV	(SP)+, 12(SP)	; ALO1: младшее
	FADD	SP		; ADR
	FDIV	SP		; DVR: y = (m-1)/(m+1)
	MOV	2(SP), -(SP)	; ALO2: копия y
	MOV	2(SP), -(SP)
	MOV	2(SP), -(SP)	; ALO2: ещё копия y
	MOV	2(SP), -(SP)
	FMUL	SP		; MLR: y^2
	MOV	(SP)+, R0	; ALO3: снять y^2
	MOV	(SP)+, R1
	MOV	#FLOGT, R2	; адрес конца таблицы коэффициентов
	MOV	-(R2), -(SP)	; c1=2.0 (младшее)
	MOV	-(R2), -(SP)	; c1 (старшее)
	MOV	R1, -(SP)	; ALO4: y^2 (младшее)
	MOV	R0, -(SP)	; y^2 (старшее)
	MOV	-(R2), -(SP)	; c2 (младшее)
	MOV	-(R2), -(SP)	; c2 (старшее)
	MOV	R1, -(SP)	; ALO4: y^2
	MOV	R0, -(SP)
	MOV	-(R2), -(SP)	; c3 (младшее)
	MOV	-(R2), -(SP)	; c3 (старшее)
	MOV	R1, -(SP)	; ALO4: y^2
	MOV	R0, -(SP)
	MOV	-(R2), -(SP)	; c4 (младшее)
	MOV	-(R2), -(SP)	; c4 (старшее)
	FMUL	SP		; MLR
	FADD	SP		; ADR
	FMUL	SP		; MLR
	FADD	SP		; ADR
	FMUL	SP		; MLR
	FADD	SP		; ADR
	FMUL	SP		; MLR: полином = ln m
	FADD	SP		; ADR
	CLR	-(SP)		; ALO5: преобразовать порядок k
	BISB	6(SP), @SP	; байт порядка k
	SUB	#200, @SP	; k = порядок - 200
	MOV	(SP)+, R0	; IR: k в R0
	CALL	ITOF		; IR: k как float на стек
	MOV	#71030, -(SP)	; ALO6: ln2 (младшее)
	MOV	#40061, -(SP)	; ln2 (старшее)
	FMUL	SP		; MLR: k * ln2
	FADD	SP		; ADR: ln x = k*ln2 + ln m
	MOV	(SP)+, R0	; ALO8: результат (старшее)
	MOV	(SP)+, R1	; результат (младшее)
	MOV	FLOG$P, SP	; сбросить стек к слоту аргумента
	MOV	R0, (SP)
	MOV	R1, 2(SP)
FLOG$X:	JMP	@#000000	; возврат
; Таблица коэффициентов (float, старшее/младшее): c4, c3, c2, c1
