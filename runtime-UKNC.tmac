; Шаблон рантайма Pesto/11 для УКНЦ (RT-11)
; Интерфейсы блоков: docs/RUNTIME.md
; Блок: строка ;#### начинает блок, ;## ИМЯ задаёт имя, ;## Need ИМЯ -- зависимость.
; Через любой вызов сохраняются R5 и SP; R0-R4 могут портиться, если не сказано иное.
;

;#####################################################################
;## INIT
; Инициализация программы, вставляется в начало кода программы
	MTPS	#340		; запрет прерываний
	CLR	@#177560	; канал 0: без прерываний от клавиатуры
	MTPS	#0		; разрешение прерываний
	MOV	SP, INIT$S	; стек RT-11 для выхода
	MOV	#-2, R0		; .SETTOP: просим всю память
	EMT	354		; в R0 -- верх памяти программы
	BIC	#1, R0		; стек всегда на чётном адресе
	MOV	R0, SP		; стек программы растёт от верха памяти

;#####################################################################
;## TERM
; Завершение программы, вставляется в конец кода программы
HALT::
INIT$S = . + 2
	MOV	#776, SP	; восстанавливаем стек RT-11 (значение пишет INIT)
	EMT	350		; .EXIT

;#####################################################################
;## WRCH
; Вывод одного символа на консоль (канал 0)
; Вход: R0 = символ. Портит: ничего.
WRCH:
1$:	TSTB	@#177564	; канал 0 готов?
	BPL	1$		; нет -- ждём
	MOV	R0, @#177566	; передаём символ
	RETURN

;#####################################################################
;## WRSPC
;## Need WRCH
; Вывод пробелов
; Вход: R1 = количество, 0 и меньше -- ничего. Портит: R0, R1.
WRSPC:
	TST	R1
	BLE	2$
	MOV	#40, R0
1$:	CALL	WRCH
	SOB	R1, 1$
2$:	RETURN

;#####################################################################
;## WRCHW
;## Need WRSPC
; Вывод символа в поле заданной ширины
; Вход: R0 = символ, R1 = ширина. Портит: R0, R1.
WRCHW:
	MOV	R0, -(SP)
	DEC	R1		; пробелов = ширина - 1
	CALL	WRSPC
	MOV	(SP)+, R0
	JMP	WRCH

;#####################################################################
;## WRSTR
; Вывод строки
; Вход: R0 = адрес строки (байт длины и символы). Портит: R0, R1, R2.
WRSTR:
	CLR	R2
	BISB	(R0)+, R2	; длина строки
	BEQ	2$		; пустая строка
1$:	MOVB	(R0)+, R1
3$:	TSTB	@#177564	; канал 0 готов?
	BPL	3$
	MOV	R1, @#177566
	SOB	R2, 1$
2$:	RETURN

;#####################################################################
;## WRSTRW
;## Need WRSTR
;## Need WRSPC
; Вывод строки в поле заданной ширины
; Вход: R0 = адрес строки, R1 = ширина. Портит: R0, R1, R2.
WRSTRW:
	MOV	R0, -(SP)
	CLR	R2
	BISB	(R0), R2	; длина строки
	SUB	R2, R1		; пробелов = ширина - длина
	CALL	WRSPC
	MOV	(SP)+, R0
	JMP	WRSTR

;#####################################################################
;## WRSTRI
;## Need WRSTR
; Вывод строковой константы; адрес строки -- слово сразу после CALL
; Портит: R0, R1, R2.
WRSTRI:
	MOV	@(SP), R0	; адрес строки из слова после CALL
	ADD	#2, (SP)	; возврат за это слово
	JMP	WRSTR

;#####################################################################
;## WRINT
;## Need WRCH
; Вывод целого числа -32768..32767
; Вход: R0 = число. Портит: R0, R1, R2, R4.
WRINT:
	MOV	R0, R4
	BPL	1$
	MOV	#'-, R0
	CALL	WRCH
	NEG	R4		; -32768 остаётся 100000: дальше без знака
1$:	CLR	R1		; флаг: значащая цифра уже была
	MOV	#10000., R2
	CALL	50$
	MOV	#1000., R2
	CALL	50$
	MOV	#100., R2
	CALL	50$
	MOV	#10., R2
	CALL	50$
	MOV	R4, R0		; последняя цифра печатается всегда
	ADD	#'0, R0
	JMP	WRCH
; Одна цифра: сколько раз R2 помещается в R4 (без знака)
50$:	MOV	#'0, R0
52$:	CMP	R4, R2
	BLO	54$
	SUB	R2, R4
	INC	R0
	INC	R1
	BR	52$
54$:	TST	R1		; ведущие нули не печатаем
	BEQ	56$
	JMP	WRCH
56$:	RETURN

;#####################################################################
;## WRINTW
;## Need WRINT
;## Need WRSPC
; Вывод целого числа в поле заданной ширины
; Вход: R0 = число, R1 = ширина. Портит: R0, R1, R2, R3, R4.
WRINTW:
	MOV	R0, -(SP)
	MOV	R0, R2
	MOV	#1, R3		; символов: минимум одна цифра
	TST	R2
	BPL	1$
	INC	R3		; знак минус
	NEG	R2
1$:	CMP	R2, #10.	; сравнения без знака: -32768 после NEG = 100000
	BLO	2$
	INC	R3
	CMP	R2, #100.
	BLO	2$
	INC	R3
	CMP	R2, #1000.
	BLO	2$
	INC	R3
	CMP	R2, #10000.
	BLO	2$
	INC	R3
2$:	SUB	R3, R1		; пробелов = ширина - символов
	CALL	WRSPC
	MOV	(SP)+, R0
	JMP	WRINT

;#####################################################################
;## WRBOOL
;## Need WRSTRW
; Вывод Boolean как TRUE или FALSE
; Вход: R0 = 0 или не 0, R1 = ширина (меньше длины -- без пробелов). Портит: R0, R1, R2.
WRBOOL:
	TST	R0
	BEQ	1$
	MOV	#WRBOO$, R0
	JMP	WRSTRW
1$:	MOV	#WRBOF$, R0
	JMP	WRSTRW
WRBOO$:	.BYTE	4, 'T, 'R, 'U, 'E
WRBOF$:	.BYTE	5, 'F, 'A, 'L, 'S, 'E
	.EVEN

;#####################################################################
;## WREOL
;## Need WRCH
; Перевод строки: CR LF
; Портит: R0.
WREOL:
	MOV	#15, R0
	CALL	WRCH
	MOV	#12, R0
	JMP	WRCH

;#####################################################################
;## RTERR
;## Need WRCH
;## Need WREOL
; Ошибка выполнения: печать "Run-time error NN, PC=nnnnnn", "Program aborted" и выход
; Вход: R0 = код ошибки (печатается в hex), (SP) = адрес возврата в программу
	.GLOBL	HALT
RTERR:
	MOV	R0, R3		; код ошибки
	MOV	(SP), R4	; адрес места в программе
	CALL	WREOL
	MOV	#RTERM$, R1	; "Run-time error "
	CALL	RTERS$
	MOV	R3, R0		; старший hex-разряд
	ASH	#-4, R0
	CALL	RTERH$
	MOV	R3, R0		; младший hex-разряд
	CALL	RTERH$
	MOV	#RTERP$, R1	; ", PC="
	CALL	RTERS$
	CLR	R0		; первая восьмеричная цифра -- бит 15
	ASL	R4
	ROL	R0
	ADD	#'0, R0
	CALL	WRCH
	MOV	#5, R2		; ещё пять цифр по три бита
1$:	CLR	R0
	ASL	R4
	ROL	R0
	ASL	R4
	ROL	R0
	ASL	R4
	ROL	R0
	ADD	#'0, R0
	CALL	WRCH
	SOB	R2, 1$
	CALL	WREOL
	MOV	#RTERA$, R1	; "Program aborted"
	CALL	RTERS$
	CALL	WREOL
	JMP	HALT
; Печать строки, завершённой нулём; R1 = адрес строки
RTERS$:	MOVB	(R1)+, R0
	BEQ	1$
	CALL	WRCH
	BR	RTERS$
1$:	RETURN
; Печать hex-разряда; R0 = значение, берутся младшие 4 бита
RTERH$:	BIC	#177760, R0
	ADD	#'0, R0
	CMP	R0, #'9
	BLOS	1$
	ADD	#7, R0		; 'A'..'F'
1$:	JMP	WRCH
RTERM$:	.ASCIZ	/Run-time error /
RTERP$:	.ASCIZ	/, PC=/
RTERA$:	.ASCIZ	/Program aborted/
	.EVEN

;#####################################################################
;## DIVZER
;## Need RTERR
; Деление на ноль, ошибка 02; вызывается сразу после DIV, когда установлен флаг V
DIVZER:
	MOV	#2, R0
	JMP	RTERR

;#####################################################################
;## RNGSCL
;## Need RTERR
; Проверка присваивания в поддиапазон или перечисление, ошибка 91
; Вход: R0 = значение; после CALL: .WORD нижняя, верхняя граница. Портит: R1.
RNGSCL:
	MOV	(SP), R1	; адрес границ
	CMP	R0, (R1)+
	BLT	1$
	CMP	R0, (R1)+
	BGT	1$
	MOV	R1, (SP)	; возврат за границы
	RETURN
1$:	MOV	#221, R0	; ошибка 91 (hex)
	JMP	RTERR

;#####################################################################
;## RNGCHK
;## Need RTERR
; Проверка индекса массива, ошибка 90
; Вход: R0 = индекс; после CALL: .WORD нижняя, верхняя граница. Портит: R1.
RNGCHK:
	MOV	(SP), R1	; адрес границ
	CMP	R0, (R1)+
	BLT	1$
	CMP	R0, (R1)+
	BGT	1$
	MOV	R1, (SP)	; возврат за границы
	RETURN
1$:	MOV	#220, R0	; ошибка 90 (hex)
	JMP	RTERR

;#####################################################################
;## ISHL
; Сдвиг влево на переменное число разрядов: R0 shl R1
; Вход: R0 = число, R1 = сдвиг. Выход: R0. Портит: R1.
ISHL:
	TST	R1
	BLE	2$
	CMP	R1, #16.
	BLT	1$
	CLR	R0		; сдвиг на 16 и больше
	RETURN
1$:	ASL	R0
	SOB	R1, 1$
2$:	RETURN

;#####################################################################
;## ISHR
; Логический сдвиг вправо на переменное число разрядов: R0 shr R1
; Вход: R0 = число, R1 = сдвиг. Выход: R0. Портит: R1.
ISHR:
	TST	R1
	BLE	2$
	CMP	R1, #16.
	BLT	1$
	CLR	R0		; сдвиг на 16 и больше
	RETURN
1$:	CLC
	ROR	R0
	SOB	R1, 1$
2$:	RETURN

;#####################################################################
;## HEAPPT
; Переменные кучи (DESIGN 6.1). Куча растёт вверх от PEND, стек -- вниз от верха памяти.
HEAPPT:	.WORD	PEND		; HeapPtr: начало свободной памяти над кучей
FREELS:	.WORD	0		; список свободных блоков: +0 следующий блок, +2 размер
HEAPRS = 256.			; запас для стека: куча не подходит к SP ближе

;#####################################################################
;## NEW
;## Need HEAPPT
;## Need RTERR
; Выделение блока в куче (New, GetMem). Сначала ищется подходящий свободный блок,
; иначе блок берётся от HeapPtr. Ошибка FF, если куча подошла бы к стеку.
; Вход: R0 = размер в байтах. Выход: R0 = адрес блока. Портит: R1, R2.
NEW:
	INC	R0		; размер округляем вверх до чётного
	BIC	#1, R0
	CMP	R0, #4		; не меньше 4 байт: место для заголовка свободного блока
	BHIS	1$
	MOV	#4, R0
1$:	MOV	#FREELS, R1	; R1 = адрес ссылки на текущий свободный блок
2$:	MOV	(R1), R2	; R2 = текущий свободный блок
	BEQ	5$		; список кончился
	CMP	2(R2), R0
	BHIS	3$		; блок подходит
	MOV	R2, R1		; ссылка на следующий лежит в слове +0 блока
	BR	2$
3$:	MOV	2(R2), R1	; размер блока
	SUB	R0, R1		; остаток
	CMP	R1, #4
	BLO	4$
	MOV	R1, 2(R2)	; остаток остаётся в списке на прежнем месте
	ADD	R1, R2		; выделяем конец блока
	MOV	R2, R0
	RETURN
4$:	MOV	(R2), (R1)	; остаток мал: убираем блок из списка целиком
	MOV	R2, R0
	RETURN
5$:	MOV	HEAPPT, R1	; новый блок от HeapPtr
	ADD	R1, R0		; R0 = новый HeapPtr
	BCS	6$
	MOV	R0, R2
	ADD	#HEAPRS, R2
	BCS	6$
	CMP	R2, SP
	BHI	6$		; куча подошла бы к стеку
	MOV	R0, HEAPPT
	MOV	R1, R0		; адрес блока
	RETURN
6$:	MOV	#377, R0	; ошибка FF: куча столкнулась со стеком
	JMP	RTERR

;#####################################################################
;## DISPOS
;## Need HEAPPT
; Освобождение блока (Dispose, FreeMem). Верхний блок опускает HeapPtr,
; другой блок добавляется в начало списка свободных. Соседние блоки не сливаются.
; Вход: R0 = адрес блока, R1 = размер в байтах. Портит: R1, R2.
DISPOS:
	INC	R1		; размер так же, как в NEW
	BIC	#1, R1
	CMP	R1, #4
	BHIS	1$
	MOV	#4, R1
1$:	MOV	R0, R2
	ADD	R1, R2		; конец блока
	CMP	R2, HEAPPT
	BNE	2$
	MOV	R0, HEAPPT	; верхний блок: опускаем HeapPtr
	RETURN
2$:	MOV	FREELS, (R0)	; в начало списка свободных
	MOV	R1, 2(R0)
	MOV	R0, FREELS
	RETURN

;#####################################################################
;## RELEAS
;## Need HEAPPT
; Release: HeapPtr := R0, список свободных блоков очищается.
; Вход: R0 = значение, сохранённое Mark. Портит: ничего.
RELEAS:
	MOV	R0, HEAPPT
	CLR	FREELS
	RETURN

;#####################################################################
;## MEMAVL
;## Need HEAPPT
; MemAvail: свободная память между кучей и стеком (за вычетом запаса) плюс свободные блоки.
; Выход: R0 = число байт (больше 32767 -- отрицательное, как в TP3). Портит: R1.
MEMAVL:
	MOV	SP, R0
	SUB	#HEAPRS, R0
	SUB	HEAPPT, R0
	BCC	1$
	CLR	R0		; запас уже занят
1$:	MOV	#FREELS, R1
2$:	MOV	(R1), R1
	BEQ	3$
	ADD	2(R1), R0
	BR	2$
3$:	RETURN

;#####################################################################
;## MAXAVL
;## Need HEAPPT
; MaxAvail: самый большой блок, который может выделить New.
; Выход: R0 = число байт (больше 32767 -- отрицательное). Портит: R1.
MAXAVL:
	MOV	SP, R0
	SUB	#HEAPRS, R0
	SUB	HEAPPT, R0
	BCC	1$
	CLR	R0
1$:	MOV	#FREELS, R1
2$:	MOV	(R1), R1
	BEQ	3$
	CMP	2(R1), R0
	BLOS	2$
	MOV	2(R1), R0	; свободный блок больше
	BR	2$
3$:	RETURN

;#####################################################################
;## FILLCH
; FillChar: заполнение памяти байтом
; Вход: R0 = адрес, R1 = количество (<= 0 -- ничего), R2 = значение. Портит: R0, R1.
FILLCH:
	TST	R1
	BLE	2$
1$:	MOVB	R2, (R0)+
	SOB	R1, 1$
2$:	RETURN

;#####################################################################
;## MOVEM
; Move: копирование байтов с учётом перекрытия областей
; Вход: R0 = откуда, R1 = куда, R2 = количество (<= 0 -- ничего). Портит: R0, R1, R2.
MOVEM:
	TST	R2
	BLE	3$
	CMP	R1, R0
	BHI	2$		; назначение выше источника: копируем с конца
1$:	MOVB	(R0)+, (R1)+
	SOB	R2, 1$
	RETURN
2$:	ADD	R2, R0
	ADD	R2, R1
4$:	MOVB	-(R0), -(R1)
	SOB	R2, 4$
3$:	RETURN

;#####################################################################
;## STRERR
;## Need RTERR
; Ошибка 10: длина строки (сцепление длиннее 255, строка не из одного символа в Char)
STRERR:
	MOV	#20, R0		; ошибка 10 (hex)
	JMP	RTERR

;#####################################################################
;## IDXERR
;## Need RTERR
; Ошибка 11: позиция вне 1..255 в Copy, Insert, Delete
IDXERR:
	MOV	#21, R0		; ошибка 11 (hex)
	JMP	RTERR

;#####################################################################
;## STCP
; Копирование строки с усечением по максимальной длине получателя
; Вход: R0 = откуда, R1 = куда, R2 = максимальная длина. Портит: R0, R1, R3.
STCP:
	CLR	R3
	BISB	(R0)+, R3	; длина источника
	CMP	R3, R2
	BLOS	1$
	MOV	R2, R3		; не помещается: усекаем
1$:	MOVB	R3, (R1)+	; длина
	BEQ	3$
2$:	MOVB	(R0)+, (R1)+
	SOB	R3, 2$
3$:	RETURN

;#####################################################################
;## STCAT
;## Need STRERR
; Сцепление: строка R1 дописывается к строке в буфере R0, ошибка 10 при длине больше 255
; Вход: R0 = буфер, R1 = что дописать. Портит: R1, R2, R3.
STCAT:
	CLR	R2
	BISB	(R0), R2	; длина в буфере
	CLR	R3
	BISB	(R1)+, R3	; длина добавки
	BEQ	2$
	ADD	R3, R2
	CMP	R2, #255.
	BHI	3$
	MOVB	R2, (R0)	; новая длина
	SUB	R3, R2
	ADD	R0, R2
	INC	R2		; R2 = адрес за последним символом
1$:	MOVB	(R1)+, (R2)+
	SOB	R3, 1$
2$:	RETURN
3$:	JMP	STRERR

;#####################################################################
;## STCATC
;## Need STRERR
; Сцепление с символом: символ R1 дописывается к строке в буфере R0
; Вход: R0 = буфер, R1 = символ. Портит: R2.
STCATC:
	CLR	R2
	BISB	(R0), R2
	CMP	R2, #255.
	BHIS	1$
	INC	R2
	MOVB	R2, (R0)	; новая длина
	ADD	R0, R2
	MOVB	R1, (R2)
	RETURN
1$:	JMP	STRERR

;#####################################################################
;## STCMP
; Сравнение строк: посимвольно без знака, при равном начале короче -- меньше
; Вход: R0 = A, R1 = B. Выход: R0 = -1 (A < B), 0 или 1, флаги как после TST R0.
; Портит: R1, R2, R3, R4.
STCMP:
	CLR	R2
	BISB	(R0)+, R2	; длина A
	CLR	R3
	BISB	(R1)+, R3	; длина B
	MOV	R2, R4
	CMP	R2, R3
	BLOS	1$
	MOV	R3, R4		; R4 = меньшая длина
1$:	TST	R4
	BEQ	3$
2$:	CMPB	(R0)+, (R1)+
	BNE	4$
	SOB	R4, 2$
3$:	CMP	R2, R3		; начало равно: сравниваем длины
	BEQ	5$
4$:	BLO	6$
	MOV	#1, R0
	RETURN
5$:	CLR	R0
	RETURN
6$:	MOV	#-1, R0
	RETURN

;#####################################################################
;## STRCH
;## Need STRERR
; Строка в Char: длина должна быть 1, иначе ошибка 10
; Вход: R0 = строка. Выход: R0 = символ.
STRCH:
	CMPB	(R0)+, #1
	BNE	1$
	MOVB	(R0), R0
	BIC	#177400, R0
	RETURN
1$:	JMP	STRERR

;#####################################################################
;## COPY
;## Need IDXERR
; Copy на месте: строка в буфере заменяется своей подстрокой
; Вход: R0 = буфер, R1 = позиция, R2 = количество. Портит: R1, R2, R3.
COPY:
	CMP	R1, #1
	BLT	9$
	CMP	R1, #255.
	BGT	9$
	CLR	R3
	BISB	(R0), R3
	SUB	R1, R3
	BLT	3$		; позиция за концом: пустая строка
	INC	R3		; символов от позиции до конца
	TST	R2
	BLE	3$
	CMP	R2, R3
	BGE	1$
	MOV	R2, R3		; берём не больше количества
1$:	MOVB	R3, (R0)	; новая длина
	MOV	R0, R2
	INC	R2		; куда: первый символ
	ADD	R0, R1		; откуда: символ в позиции
2$:	MOVB	(R1)+, (R2)+
	SOB	R3, 2$
	RETURN
3$:	CLRB	(R0)
	RETURN
9$:	JMP	IDXERR

;#####################################################################
;## POS
; Pos: позиция первого вхождения образца в строку, 0 -- нет (и для пустого образца)
; Вход: R0 = образец, R1 = строка. Выход: R0 = позиция. Портит: R1, R2, R3, R4.
POS:
	CLR	R2
	BISB	(R0)+, R2	; длина образца
	BEQ	5$
	CLR	R3
	BISB	(R1)+, R3	; длина строки
	SUB	R2, R3
	BLT	5$
	INC	R3		; сколько позиций проверить
	MOV	R1, -(SP)	; адрес позиции 1
1$:	MOV	R0, -(SP)	; образец
	MOV	R1, -(SP)	; текущая позиция
	MOV	R2, R4
2$:	CMPB	(R0)+, (R1)+
	BNE	3$
	SOB	R4, 2$
	MOV	(SP)+, R0	; нашли
	TST	(SP)+
	SUB	(SP)+, R0
	INC	R0
	RETURN
3$:	MOV	(SP)+, R1
	MOV	(SP)+, R0
	INC	R1		; следующая позиция
	SOB	R3, 1$
	TST	(SP)+
5$:	CLR	R0
	RETURN

;#####################################################################
;## INSERT
;## Need IDXERR
; Insert: вставка строки в переменную; позиция за концом -- дописывание,
; лишнее за максимальной длиной отбрасывается
; Вход: R0 = что, R1 = куда, R2 = максимальная длина, R3 = позиция. Портит: R0-R4.
INSERT:
	CMP	R3, #1
	BLT	9$
	CMP	R3, #255.
	BGT	9$
	CLR	R4
	BISB	(R1), R4	; длина строки
	CMP	R3, R4
	BLOS	1$
	MOV	R4, R3
	INC	R3		; позиция за концом: дописываем
1$:	MOV	R2, -(SP)	; максимальная длина
	CLR	R2
	BISB	(R0)+, R2	; R2 = длина вставки, R0 -> её символы
	BEQ	7$
	ADD	R2, R4		; новая длина, не больше максимальной
	CMP	R4, (SP)
	BLOS	2$
	MOV	(SP), R4
2$:	MOV	R4, (SP)	; (SP) = новая длина
	ADD	R1, R4		; R4 = адрес последнего символа новой строки
	MOV	R0, -(SP)
	MOV	R4, -(SP)	; (SP) = предел, 2(SP) = символы вставки
	CLR	R4
	BISB	(R1), R4
	ADD	R1, R4		; R4 = последний символ хвоста
	ADD	R1, R3		; R3 = адрес позиции вставки
	MOV	R4, R0
	ADD	R2, R0		; R0 = куда переносится последний символ хвоста
3$:	CMP	R4, R3
	BLO	5$		; хвост перенесён
	CMP	R0, (SP)
	BHI	4$		; за новой длиной: отбрасываем
	MOVB	(R4), (R0)
4$:	DEC	R4
	DEC	R0
	BR	3$
5$:	MOV	(SP)+, R4	; предел
	MOV	(SP)+, R0	; символы вставки
6$:	CMP	R3, R4
	BHI	8$
	MOVB	(R0)+, (R3)+
	SOB	R2, 6$
8$:	MOVB	(SP)+, (R1)	; новая длина
	RETURN
7$:	TST	(SP)+		; вставлять нечего
	RETURN
9$:	JMP	IDXERR

;#####################################################################
;## DELETE
;## Need IDXERR
; Delete: удаление символов; позиция за концом -- ничего, лишнее количество -- до конца
; Вход: R0 = строка, R1 = позиция, R2 = количество. Портит: R1-R4.
DELETE:
	CMP	R1, #1
	BLT	9$
	CMP	R1, #255.
	BGT	9$
	CLR	R3
	BISB	(R0), R3
	SUB	R1, R3
	BLT	3$		; позиция за концом
	INC	R3		; символов от позиции до конца
	TST	R2
	BLE	3$
	CMP	R2, R3
	BLE	1$
	MOV	R3, R2		; удаляем до конца
1$:	SUB	R2, R3		; R3 = сколько символов сдвинуть
	CLR	R4
	BISB	(R0), R4
	SUB	R2, R4
	MOVB	R4, (R0)	; новая длина
	ADD	R0, R1		; куда
	TST	R3
	BEQ	3$
	MOV	R1, R4
	ADD	R2, R4		; откуда
2$:	MOVB	(R4)+, (R1)+
	SOB	R3, 2$
3$:	RETURN
9$:	JMP	IDXERR

;#####################################################################
;## UPCAS
; UpCase: латинская строчная буква -> прописная
; Вход и выход: R0 = символ.
UPCAS:
	CMP	R0, #'a
	BLO	1$
	CMP	R0, #'z
	BHI	1$
	SUB	#40, R0
1$:	RETURN

;#####################################################################
;## STRI
; Str(I:W, S): число в строку, слева дополняется пробелами до ширины, усекается по длине S
; Вход: R0 = число, R1 = ширина (-1 -- нет), R2 = строка, R3 = максимальная длина.
; Портит: R0-R4.
STRI:
	MOV	R2, -(SP)	; строка
	MOV	R1, -(SP)	; ширина
	SUB	#8., SP		; буфер цифр
	MOV	SP, R4
	ADD	#8., R4		; цифры пишутся с конца буфера
	MOV	R0, -(SP)	; знак
	BPL	1$
	NEG	R0		; -32768 остаётся 100000: делим без знака
1$:	MOV	R0, R1
2$:	CLR	R0
	DIV	#10., R0	; R0 = частное, R1 = остаток
	ADD	#'0, R1
	MOVB	R1, -(R4)
	MOV	R0, R1
	BNE	2$
	TST	(SP)+
	BPL	3$
	MOVB	#'-, -(R4)
3$:	MOV	SP, R0
	ADD	#8., R0
	SUB	R4, R0		; R0 = число символов
	MOV	8.(SP), R1
	SUB	R0, R1		; R1 = сколько пробелов
	BGT	4$
	CLR	R1
4$:	MOV	10.(SP), R2	; строка
	ADD	R1, R0		; полная длина, не больше максимальной
	CMP	R0, R3
	BLOS	5$
	MOV	R3, R0
5$:	MOVB	R0, (R2)+
	BEQ	8$
6$:	TST	R1
	BEQ	7$
	MOVB	#40, (R2)+	; пробел
	DEC	R1
	SOB	R0, 6$
	BR	8$
7$:	MOVB	(R4)+, (R2)+
	SOB	R0, 7$
8$:	ADD	#12., SP
	RETURN

;#####################################################################
;## VALI
; Val(S, I, Code) для Integer: знак, десятичные цифры или $ и шестнадцатеричные;
; пробелы не допускаются (как в TP3)
; Вход: R0 = строка. Выход: R0 = значение, R1 = 0 или позиция первого ошибочного символа.
; Портит: R2, R3, R4.
VALI:
	CLR	R2
	BISB	(R0)+, R2	; длина
	MOV	#1, R1		; позиция текущего символа
	CLR	R3		; значение
	CLR	-(SP)		; знак: 0 -- плюс, 1 -- минус
	TST	R2
	BEQ	9$		; пустая строка
	CMPB	(R0), #'-
	BNE	1$
	INC	(SP)
	BR	2$
1$:	CMPB	(R0), #'+
	BNE	3$
2$:	INC	R0
	INC	R1
	DEC	R2
	BEQ	9$		; только знак
3$:	CMPB	(R0), #'$
	BEQ	20$
4$:	CLR	R4		; десятичная цифра
	BISB	(R0)+, R4
	SUB	#'0, R4
	CMP	R4, #9.
	BHI	9$
	CMP	R3, #3276.
	BHI	9$
	MUL	#10., R3
	ADD	R4, R3
	SUB	(SP), R3	; не больше 32767, с минусом -- 32768
	CMP	R3, #77777
	BHI	9$
	ADD	(SP), R3
	INC	R1
	SOB	R2, 4$
	BR	5$
20$:	INC	R0		; шестнадцатеричное число
	INC	R1
	DEC	R2
	BEQ	9$
21$:	CLR	R4
	BISB	(R0)+, R4
	CMP	R4, #'a
	BLO	22$
	SUB	#40, R4		; строчная -> прописная
22$:	SUB	#'0, R4
	CMP	R4, #9.
	BLOS	23$
	SUB	#7, R4		; 'A'..'F' -> 10..15
	CMP	R4, #10.
	BLO	9$
	CMP	R4, #15.
	BHI	9$
23$:	BIT	#170000, R3
	BNE	9$		; не помещается в 16 бит
	ASH	#4, R3
	BIS	R4, R3
	INC	R1
	SOB	R2, 21$
5$:	MOV	R3, R0
	TST	(SP)+
	BEQ	6$
	NEG	R0
6$:	CLR	R1
	RETURN
9$:	TST	(SP)+		; ошибка: R1 = позиция
	MOV	R3, R0
	RETURN

;#####################################################################
;## SETCLR
; Пустое множество в 32-байтовом буфере
; Вход: R0 = буфер. Портит: R0, R1.
SETCLR:
	MOV	#16., R1
1$:	CLR	(R0)+
	SOB	R1, 1$
	RETURN

;#####################################################################
;## SETLD
; Загрузка: сжатая переменная разворачивается в 32-байтовый буфер, остальные байты 0
; Вход: R0 = переменная, R1 = буфер, R2 = Min div 8, R3 = размер. Портит: R0-R4.
SETLD:
	MOV	R1, R4
	ADD	R2, R1		; место первого хранимого байта
	MOV	#16., R2
1$:	CLR	(R4)+
	SOB	R2, 1$
2$:	MOVB	(R0)+, (R1)+
	SOB	R3, 2$
	RETURN

;#####################################################################
;## SETST
; Запись: из 32-байтового буфера в сжатую переменную; байты вне переменной отбрасываются
; Вход: R0 = буфер, R1 = переменная, R2 = Min div 8, R3 = размер. Портит: R0, R1, R3.
SETST:
	ADD	R2, R0
1$:	MOVB	(R0)+, (R1)+
	SOB	R3, 1$
	RETURN

;#####################################################################
;## SETADD
; Элемент во множество (конструктор [a]); элемент вне 0..255 отбрасывается
; Вход: R0 = элемент, R1 = буфер. Портит: R0, R1, R2.
SETADD:
	CMP	R0, #255.
	BHI	1$
	MOV	R0, R2
	ASH	#-3, R2		; номер байта
	ADD	R2, R1
	BIC	#177770, R0	; номер бита
	MOV	#1, R2
	ASH	R0, R2		; маска
	BISB	R2, (R1)
1$:	RETURN

;#####################################################################
;## SETRNG
; Диапазон во множество (конструктор [a..b]); часть вне 0..255 отбрасывается
; Вход: R0 = от, R1 = до, R2 = буфер. Портит: R0, R1, R3, R4.
SETRNG:
	TST	R0
	BGE	1$
	CLR	R0
1$:	CMP	R1, #255.
	BLE	2$
	MOV	#255., R1
2$:	CMP	R0, R1
	BGT	4$		; пустой диапазон
3$:	MOV	R0, R3
	ASH	#-3, R3
	ADD	R2, R3		; адрес байта
	MOV	R0, -(SP)
	BIC	#177770, (SP)	; номер бита
	MOV	#1, R4
	ASH	(SP)+, R4	; маска
	BISB	R4, (R3)
	INC	R0
	CMP	R0, R1
	BLE	3$
4$:	RETURN

;#####################################################################
;## SETUN
; Объединение A + B, результат на месте A
; Вход: R0 = A (буфер), R1 = B (32 байта). Портит: R0, R1, R2.
SETUN:
	MOV	#16., R2
1$:	BIS	(R1)+, (R0)+
	SOB	R2, 1$
	RETURN

;#####################################################################
;## SETIS
; Пересечение A * B, результат на месте A
; Вход: R0 = A (буфер), R1 = B (32 байта). Портит: R0, R1, R2, R3.
SETIS:
	MOV	#16., R2
1$:	MOV	(R1)+, R3
	COM	R3
	BIC	R3, (R0)+
	SOB	R2, 1$
	RETURN

;#####################################################################
;## SETDF
; Разность A - B, результат на месте A
; Вход: R0 = A (буфер), R1 = B (32 байта). Портит: R0, R1, R2.
SETDF:
	MOV	#16., R2
1$:	BIC	(R1)+, (R0)+
	SOB	R2, 1$
	RETURN

;#####################################################################
;## SETEQ
; Равенство множеств одной раскладки (32 байта или сжатые переменные одного типа)
; Вход: R0 = A, R1 = B, R2 = число байт. Выход: R0 = 0 и Z = 1, если равны. Портит: R1, R2.
SETEQ:
	CMPB	(R0)+, (R1)+
	BNE	1$
	SOB	R2, SETEQ
	CLR	R0
	RETURN
1$:	MOV	#1, R0
	RETURN

;#####################################################################
;## SETLE
; Включение A <= B: в A нет элементов, которых нет в B
; Вход: R0 = A, R1 = B, R2 = число байт. Выход: R0 = 0 и Z = 1, если да. Портит: R1, R2, R3.
SETLE:
	MOVB	(R0)+, R3
	BICB	(R1)+, R3	; элементы A, которых нет в B
	BNE	1$
	SOB	R2, SETLE
	CLR	R0
	RETURN
1$:	MOV	#1, R0
	RETURN

;#####################################################################
;## SETIN
; Проверка элемента в развёрнутом множестве (in); элемент вне 0..255 не входит
; Вход: R0 = элемент, R1 = 32 байта. Выход: R0 = 0 и Z = 1, если входит. Портит: R1, R2.
SETIN:
	CMP	R0, #255.
	BHI	1$
	MOV	R0, R2
	ASH	#-3, R2
	ADD	R2, R1		; адрес байта
	BIC	#177770, R0
	MOV	#1, R2
	ASH	R0, R2		; маска
	BITB	R2, (R1)
	BEQ	1$
	CLR	R0
	RETURN
1$:	MOV	#1, R0
	RETURN

;#####################################################################
;## SETINV
; Проверка элемента прямо в сжатой переменной (in), без разворачивания
; Вход: R0 = элемент, R1 = переменная, R2 = Min div 8, R3 = размер.
; Выход: R0 = 0 и Z = 1, если входит. Портит: R1, R2, R4.
SETINV:
	CMP	R0, #255.
	BHI	1$
	MOV	R0, R4
	ASH	#-3, R4
	SUB	R2, R4		; номер байта в переменной
	BLT	1$
	CMP	R4, R3
	BGE	1$		; байт вне переменной
	ADD	R4, R1
	BIC	#177770, R0
	MOV	#1, R2
	ASH	R0, R2		; маска
	BITB	R2, (R1)
	BEQ	1$
	CLR	R0
	RETURN
1$:	MOV	#1, R0
	RETURN

;#####################################################################
;## FISON
;## Need RTERR
; Обработчик прерывания FIS (вектор 244): ставится после INIT, если в программе есть Real.
; При ошибке FIS операнды и SP не меняются, PC и PS кладутся прямо под операнды:
; (SP) = PC, 2(SP) = PS, 4(SP) = B, 10(SP) = A. Коды условий: V -- переполнение,
; N+V -- потеря значимости, N+V+C -- деление на ноль.
FISON:
	MOV	@#244, FIS$V	; прежний вектор
	MOV	@#246, FIS$V+2
	MOV	#FISTRP, @#244
	CLR	@#246
	RETURN
FISTRP:
	BIT	#1, 2(SP)	; C: деление на ноль
	BNE	2$
	BIT	#10, 2(SP)	; N: потеря значимости
	BEQ	1$
	CLR	10(SP)		; результат 0.0 на месте A
	CLR	12(SP)
	MOV	2(SP), 6(SP)	; PS и PC сдвигаются на место B
	MOV	(SP), 4(SP)
	ADD	#4, SP
	RTI
1$:	MOV	#1, R0		; ошибка 01: переполнение Real
	JMP	RTERR		; (SP) = адрес после команды FIS
2$:	MOV	#2, R0		; ошибка 02: деление на ноль
	JMP	RTERR
FIS$V:	.WORD	0, 0

;#####################################################################
;## FISOFF
;## Need FISON
; Возврат прежнего вектора прерывания FIS, вызывается после HALT
FISOFF:
	MOV	FIS$V, @#244
	MOV	FIS$V+2, @#246
	RETURN

;#####################################################################
;## ITOF
; Integer -> Real.
; Вход: R0 = число. Выход: Real на стеке. R0 не меняется. Портит: R1-R4.
ITOF:
	MOV	R0, -(SP)	; место под Real: здесь и на месте адреса возврата
	CLR	R1		; младшее слово
	TST	R0
	BEQ	3$		; 0 -> 0.0
	MOV	R0, R2		; знак
	BPL	1$
	NEG	R0		; -32768 даёт 100000: дальше число без знака
1$:	MOV	#221, R4	; порядок 128 + 17, уменьшается при нормализации
2$:	DEC	R4
	ASL	R0
	BCC	2$		; старшая единица ушла в C, в R0 -- дробная часть
	ASHC	#-9., R0	; 7 бит дроби в R0, 16 бит в R1
	BIC	#177600, R0
	ASH	#7, R4
	BIS	R4, R0		; порядок
	TST	R2
	BPL	3$
	BIS	#100000, R0	; знак
3$:	MOV	2(SP), R3	; адрес возврата
	MOV	R1, 2(SP)	; младшее слово
	MOV	(SP), R4	; исходное R0
	MOV	R0, (SP)	; старшее слово
	MOV	R4, R0
	JMP	(R3)

;#####################################################################
;## FTOI
;## Need RTERR
; Trunc: Real -> Integer (отбрасывание дробной части), ошибка 92 вне -32768..32767.
; Вход: Real на стеке. Выход: R0, Real снят. Портит: R1-R4.
FTOI:
	MOV	(SP)+, R3	; адрес возврата
	MOV	(SP)+, R0	; старшее слово
	MOV	(SP)+, R1	; младшее слово
	MOV	R0, R2		; знак
	MOV	R0, R4
	ASH	#-7, R4
	BIC	#177400, R4	; порядок
	SUB	#200, R4
	BLE	3$		; |x| < 1 -> 0
	CMP	R4, #16.
	BGT	9$		; |x| >= 2^16
	BIC	#177600, R0
	BIS	#200, R0	; 24-битная мантисса со скрытой единицей
	SUB	#24., R4
	ASHC	R4, R0		; вправо: в R1 целая часть
	TST	R2
	BMI	1$
	TST	R1
	BMI	9$		; больше 32767
	BR	2$
1$:	NEG	R1
	BGT	9$		; меньше -32768
2$:	MOV	R1, R0
	JMP	(R3)
3$:	CLR	R0
	JMP	(R3)
9$:	MOV	R3, -(SP)	; для RTERR: адрес в программе
	MOV	#222, R0	; ошибка 92: вне диапазона Integer
	JMP	RTERR

;#####################################################################
;## FROUND
;## Need FTOI
; Round: Real -> Integer с округлением половины от нуля, ошибка 92.
; Вход: Real на стеке. Выход: R0, Real снят. Портит: R1-R4.
FROUND:
	MOV	(SP)+, FROU$R	; адрес возврата
	CLR	-(SP)		; 0.5
	MOV	#40000, -(SP)
	TST	4(SP)
	BPL	1$
	BIS	#100000, (SP)	; -0.5 для отрицательных
1$:	FADD	SP
	MOV	FROU$R, -(SP)
	JMP	FTOI
FROU$R:	.WORD	0

;#####################################################################
;## FCMP
; Сравнение Real: A (ниже) с B (на вершине), оба снимаются.
; Выход: R0 = -1 (A < B), 0 или 1, флаги как после TST R0. Портит: R1-R3.
FCMP:
	MOV	6(SP), R0	; A: старшее слово
	MOV	10(SP), R1
	TST	R0
	BPL	1$
	BIC	#100000, R0	; отрицательное: модуль со знаком минус как 32-битное число
	NEG	R0
	NEG	R1
	SBC	R0
1$:	MOV	2(SP), R2	; B
	MOV	4(SP), R3
	TST	R2
	BPL	2$
	BIC	#100000, R2
	NEG	R2
	NEG	R3
	SBC	R2
2$:	MOV	(SP), 10(SP)	; адрес возврата над числами
	ADD	#10, SP		; числа сняты
	CMP	R0, R2
	BLT	4$
	BGT	5$
	CMP	R1, R3
	BLO	4$
	BHI	5$
	CLR	R0
	RETURN
4$:	MOV	#-1, R0
	RETURN
5$:	MOV	#1, R0
	RETURN

;#####################################################################
;## FINT
; Int: отбрасывание дробной части Real (к нулю), на месте.
; Вход и выход: Real на стеке под адресом возврата. Портит: R0, R1, R2.
FINT:
	MOV	2(SP), R0
	MOV	R0, R2
	ASH	#-7, R2
	BIC	#177400, R2	; порядок
	SUB	#200, R2
	BGT	1$
	CLR	2(SP)		; |x| < 1 -> 0.0
	CLR	4(SP)
	RETURN
1$:	SUB	#24., R2	; минус число дробных бит
	BGE	2$		; дробных бит нет
	NEG	R2
	CLR	R0
	MOV	#1, R1
	ASHC	R2, R0
	SUB	#1, R1
	SBC	R0		; маска дробных бит
	BIC	R1, 4(SP)
	BIC	R0, 2(SP)
2$:	RETURN

;#####################################################################
;## FRNDI
;## Need FRND
;## Need ITOF
;## Need FTOI
; Random(N): целое 0..N-1.
; Вход: R0 = N. Выход: R0. Портит: R1-R4.
FRNDI:
	MOV	R0, -(SP)	; N
	CLR	-(SP)		; 1.0: следующее случайное число
	MOV	#40200, -(SP)
	CALL	FRND
	MOV	4(SP), R0
	CALL	ITOF
	FMUL	SP
	CALL	FTOI
	TST	(SP)+		; N
	RETURN

;#####################################################################
;## RANDZ
;## Need FRND
; Randomize: начальное значение генератора от системного времени (.GTIM).
; Портит: R0.
RANDZ:
	MOV	#RNDZ$A, R0
	EMT	375		; .GTIM: время в тиках от полуночи
	MOV	RNDZ$T, FRND$I
	MOV	RNDZ$T+2, FRND$I+2
	BIS	#1, FRND$I+2	; не ноль
	RETURN
RNDZ$A:.BYTE	0, 21		; канал 0, код .GTIM
	.WORD	RNDZ$T
RNDZ$T:.WORD	0, 0

;#####################################################################
;## FSCAL
; Умножение Real на 10^R0 по таблице степеней 10^0..10^38: одно умножение или деление
; (два при |R0| > 38), чтобы не накапливать ошибку округления.
; Вход: Real на стеке под адресом возврата, R0 = степень (-76..76). R0 не меняется. Портит: R1, R2.
FSCAL:
	MOV	(SP)+, FSCA$R
	MOV	R0, R1
	BPL	1$
	NEG	R1
1$:	MOV	R1, R2		; не больше 38 за один раз
	CMP	R2, #38.
	BLE	2$
	MOV	#38., R2
2$:	SUB	R2, R1		; остаток
	ASL	R2
	ASL	R2
	MOV	P10T$+2(R2), -(SP)
	MOV	P10T$(R2), -(SP)
	TST	R0
	BMI	3$
	FMUL	SP
	BR	4$
3$:	FDIV	SP
4$:	TST	R1
	BNE	1$
	JMP	@FSCA$R
FSCA$R:	.WORD	0
P10T$:
	.WORD	40200, 0	; 1E0
	.WORD	41040, 0	; 1E1
	.WORD	41710, 0	; 1E2
	.WORD	42572, 0	; 1E3
	.WORD	43434, 40000	; 1E4
	.WORD	44303, 50000	; 1E5
	.WORD	45164, 22000	; 1E6
	.WORD	46030, 113200	; 1E7
	.WORD	46676, 136040	; 1E8
	.WORD	47556, 65450	; 1E9
	.WORD	50425, 1371	; 1E10
	.WORD	51272, 41667	; 1E11
	.WORD	52150, 152245	; 1E12
	.WORD	53021, 102347	; 1E13
	.WORD	53665, 163041	; 1E14
	.WORD	54543, 57651	; 1E15
	.WORD	55416, 15712	; 1E16
	.WORD	56261, 121274	; 1E17
	.WORD	57136, 5553	; 1E18
	.WORD	60012, 143443	; 1E19
	.WORD	60655, 74354	; 1E20
	.WORD	61530, 153447	; 1E21
	.WORD	62407, 103170	; 1E22
	.WORD	63251, 64026	; 1E23
	.WORD	64123, 141034	; 1E24
	.WORD	65004, 54521	; 1E25
	.WORD	65645, 67646	; 1E26
	.WORD	66516, 145617	; 1E27
	.WORD	67401, 37471	; 1E28
	.WORD	70241, 107410	; 1E29
	.WORD	71111, 171312	; 1E30
	.WORD	71774, 67574	; 1E31
	.WORD	72635, 142656	; 1E32
	.WORD	73505, 33431	; 1E33
	.WORD	74366, 102337	; 1E34
	.WORD	75232, 11414	; 1E35
	.WORD	76100, 113716	; 1E36
	.WORD	76760, 136702	; 1E37
	.WORD	77626, 73231	; 1E38
;#####################################################################
;## LTOF
; 32-битное целое без знака -> Real с округлением.
; Вход: R0:R1. Выход: Real на стеке. Портит: R0, R1, R2.
LTOF:
	MOV	(SP)+, LTOF$R
	MOV	R0, R2
	BIS	R1, R2
	BEQ	3$		; 0 -> 0.0
	MOV	#240, R2	; порядок 128 + 32
1$:	TST	R0
	BMI	2$
	ASHC	#1, R0		; нормализация: старшая единица в бит 31
	DEC	R2
	BR	1$
2$:	ADD	#200, R1	; округление до 24 бит
	ADC	R0
	BCC	4$
	MOV	#100000, R0	; перенос: мантисса 1.0, порядок + 1
	CLR	R1
	INC	R2
4$:	ASHC	#-8., R0	; R0: старшие 8 бит мантиссы, R1: следующие 16
	BIC	#177600, R0	; скрытая единица
	ASH	#7, R2
	BIS	R2, R0
3$:	MOV	R1, -(SP)
	MOV	R0, -(SP)
	JMP	@LTOF$R
LTOF$R:	.WORD	0

;#####################################################################
;## FDIG7
; 7 десятичных цифр Real > 0: x = D0.D1...D6 * 10^E, без потери точности.
; x = M * 2^e2 (M -- 24 бита). N = M * T >> k, где 10^p = T * 2^t (T -- 32 бита из таблицы),
; p = 7 - E, k = -(e2 + t): N = x * 10^p -- 8 цифр, точно с отбрасыванием дробной части.
; Восьмая цифра нужна только для округления до 7.
; Вход: Real на стеке. Выход: цифры ASCII в FDIG$D, порядок в FDIG$E, Real снят. Портит: R0-R4.
FDIG7:
	MOV	(SP)+, FDIG$R
	TST	(SP)
	BNE	1$
	CMP	(SP)+, (SP)+	; ноль: цифры 0000000, порядок 0
	MOV	#FDIG$D, R0
	MOV	#7, R1
5$:	MOVB	#'0, (R0)+
	SOB	R1, 5$
	CLR	FDIG$E
	JMP	@FDIG$R
1$:	MOV	(SP)+, R0	; старшее слово
	MOV	(SP)+, R1	; младшее слово
	MOV	R0, R2
	ASH	#-7, R2
	BIC	#177400, R2
	SUB	#230, R2	; e2 = порядок - 152
	MOV	R2, FDIG$B
	BIC	#177600, R0
	BIS	#200, R0	; M со скрытой единицей
	ASHC	#8., R0		; M выровнена к биту 31
	MOV	R0, FDIG$M
	MOV	R1, FDIG$M+2
	MOV	R2, R0		; оценка E = (e2 + 23) * 77 / 256
	ADD	#23., R0
	MUL	#77., R0
	MOV	R1, R0
	ASH	#-8., R0
	MOV	R0, FDIG$E
2$:	MOV	#7, R4		; T, t для p = 7 - E
	SUB	FDIG$E, R4
	ADD	#34., R4	; номер строки таблицы
	ASL	R4
	MOV	R4, R3
	ASL	R4
	ADD	R3, R4		; * 6 байт
	ADD	#FDIG$T, R4
	MOV	(R4)+, FDG$TH
	MOV	(R4)+, FDG$TL
	MOV	(R4), R4
	ADD	FDIG$B, R4
	NEG	R4
	MOV	R4, FDIG$K	; k = -(e2 + t)
	CLR	R0		; P = M * T: R0:R1:R2:R3
	CLR	R1
	CLR	R2
	CLR	R3
	MOV	FDIG$M, FDIG$X
	MOV	FDIG$M+2, FDIG$X+2
	MOV	#24., R4
3$:	ASL	R3		; P = P * 2
	ROL	R2
	ROL	R1
	ROL	R0
	ASL	FDIG$X+2	; очередной бит M
	ROL	FDIG$X
	BCC	4$
	ADD	FDG$TL, R3	; P = P + T
	ADC	R2
	ADC	R1
	ADC	R0
	ADD	FDG$TH, R2
	ADC	R1
	ADC	R0
4$:	SOB	R4, 3$
	MOV	FDIG$K, R4	; N = P >> k
6$:	CLC
	ROR	R0
	ROR	R1
	ROR	R2
	ROR	R3
	SOB	R4, 6$
	CMP	R2, #2765	; N >= 10^8 = 2765:160400 ?
	BHI	7$
	BLO	8$
	CMP	R3, #160400
	BLO	8$
7$:	INC	FDIG$E		; на одну цифру меньше
	BR	2$
8$:	CMP	R2, #230	; N < 10^7 = 230:113200 ?
	BHI	9$
	BLO	10$
	CMP	R3, #113200
	BHIS	9$
10$:	DEC	FDIG$E		; на одну цифру больше
	BR	2$
9$:	MOV	R2, R0
	MOV	R3, R1
	DIV	#10000., R0	; R0 = 4 старшие цифры, R1 = 4 младшие
	MOV	R0, -(SP)
	MOV	#FDIG$D+8., R2
	CALL	20$
	MOV	(SP)+, R1
	CALL	20$
	CMPB	FDIG$D+7, #'5	; округление до 7 цифр
	BLO	13$
	MOV	#FDIG$D+7, R2
11$:	CMP	R2, #FDIG$D
	BEQ	12$
	INCB	-(R2)
	CMPB	(R2), #'9+1
	BLO	13$
	MOVB	#'0, (R2)
	BR	11$
12$:	MOVB	#'1, FDIG$D	; 9999999.5 -> 1000000, порядок + 1
	INC	FDIG$E
13$:	JMP	@FDIG$R
20$:	MOV	#4, R3		; 4 цифры числа R1 перед адресом R2
21$:	CLR	R0
	DIV	#10., R0
	ADD	#'0, R1
	MOVB	R1, -(R2)
	MOV	R0, R1
	SOB	R3, 21$
	RETURN
FDIG$R:	.WORD	0
FDIG$E:	.WORD	0
FDIG$B:	.WORD	0		; e2
FDIG$K:	.WORD	0		; k
FDIG$M:	.WORD	0, 0		; M << 8
FDIG$X:	.WORD	0, 0
FDG$TH:.WORD	0
FDG$TL:.WORD	0
FDIG$D:	.BLKB	8.		; 7 цифр и восьмая для округления
	.EVEN
; 10^p = T * 2^t для p = -34..48: старшее и младшее слово T, t
FDIG$T:
	.WORD	102354, 36230, -144.	; 1E-34
	.WORD	123047, 45676, -141.	; 1E-33
	.WORD	147661, 17255, -138.	; 1E-32
	.WORD	100716, 131454, -134.	; 1E-31
	.WORD	121102, 57767, -131.	; 1E-30
	.WORD	145322, 173765, -128.	; 1E-29
	.WORD	176607, 132763, -125.	; 1E-28
	.WORD	117164, 150670, -121.	; 1E-27
	.WORD	143022, 3045, -118.	; 1E-26
	.WORD	173626, 103657, -115.	; 1E-25
	.WORD	115276, 12315, -111.	; 1E-24
	.WORD	140555, 115001, -108.	; 1E-23
	.WORD	170711, 201, -105.	; 1E-22
	.WORD	113435, 120120, -101.	; 1E-21
	.WORD	136345, 4145, -98.	; 1E-20
	.WORD	166036, 45176, -95.	; 1E-19
	.WORD	111622, 167217, -91.	; 1E-18
	.WORD	134167, 125062, -88.	; 1E-17
	.WORD	163225, 112277, -85.	; 1E-16
	.WORD	110035, 76367, -81.	; 1E-15
	.WORD	132044, 156065, -78.	; 1E-14
	.WORD	160456, 11502, -75.	; 1E-13
	.WORD	106274, 146011, -71.	; 1E-12
	.WORD	127753, 177414, -68.	; 1E-11
	.WORD	155746, 177317, -65.	; 1E-10
	.WORD	104560, 57501, -61.	; 1E-9
	.WORD	125714, 73422, -58.	; 1E-8
	.WORD	153277, 112326, -55.	; 1E-7
	.WORD	103067, 136406, -51.	; 1E-6
	.WORD	123705, 126107, -48.	; 1E-5
	.WORD	150667, 13531, -45.	; 1E-4
	.WORD	101422, 67230, -41.	; 1E-3
	.WORD	121727, 5075, -38.	; 1E-2
	.WORD	146314, 146315, -35.	; 1E-1
	.WORD	100000, 0, -31.	; 1E0
	.WORD	120000, 0, -28.	; 1E1
	.WORD	144000, 0, -25.	; 1E2
	.WORD	175000, 0, -22.	; 1E3
	.WORD	116100, 0, -18.	; 1E4
	.WORD	141520, 0, -15.	; 1E5
	.WORD	172044, 0, -12.	; 1E6
	.WORD	114226, 100000, -8.	; 1E7
	.WORD	137274, 20000, -5.	; 1E8
	.WORD	167153, 24000, -2.	; 1E9
	.WORD	112402, 174400, 2.	; 1E10
	.WORD	135103, 133500, 5.	; 1E11
	.WORD	164324, 122420, 8.	; 1E12
	.WORD	110604, 163452, 12.	; 1E13
