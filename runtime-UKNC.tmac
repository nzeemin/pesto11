; Шаблон рантайма Pesto/11 для УКНЦ (RT-11)
; Интерфейсы блоков: docs/RUNTIME.md
; Блок: строка ;#### начинает блок, ;## ИМЯ задаёт имя, ;## Need ИМЯ -- зависимость.
; Через любой вызов сохраняются R5 и SP; R0-R4 могут портиться, если не сказано иное.
;

;#####################################################################
;## INIT
; Инициализация программы, вставляется в начало кода программы
	MTPS	#340		; запрет прерываний
	CLR	@#177560	; канал 0: без прерываний от клавиатуры
	MTPS	#0		; разрешение прерываний
	MOV	SP, INIT$S	; стек RT-11 для выхода

;#####################################################################
;## TERM
; Завершение программы, вставляется в конец кода программы
HALT::
INIT$S = . + 2
	MOV	#776, SP	; восстанавливаем стек RT-11 (значение пишет INIT)
	EMT	350		; .EXIT

;#####################################################################
;## WRCH
; Вывод одного символа на консоль (канал 0)
; Вход: R0 = символ. Портит: ничего.
WRCH:
1$:	TSTB	@#177564	; канал 0 готов?
	BPL	1$		; нет -- ждём
	MOV	R0, @#177566	; передаём символ
	RETURN

;#####################################################################
;## WRSPC
;## Need WRCH
; Вывод пробелов
; Вход: R1 = количество, 0 и меньше -- ничего. Портит: R0, R1.
WRSPC:
	TST	R1
	BLE	2$
	MOV	#40, R0
1$:	CALL	WRCH
	SOB	R1, 1$
2$:	RETURN

;#####################################################################
;## WRCHW
;## Need WRSPC
; Вывод символа в поле заданной ширины
; Вход: R0 = символ, R1 = ширина. Портит: R0, R1.
WRCHW:
	MOV	R0, -(SP)
	DEC	R1		; пробелов = ширина - 1
	CALL	WRSPC
	MOV	(SP)+, R0
	JMP	WRCH

;#####################################################################
;## WRSTR
; Вывод строки
; Вход: R0 = адрес строки (байт длины и символы). Портит: R0, R1, R2.
WRSTR:
	CLR	R2
	BISB	(R0)+, R2	; длина строки
	BEQ	2$		; пустая строка
1$:	MOVB	(R0)+, R1
3$:	TSTB	@#177564	; канал 0 готов?
	BPL	3$
	MOV	R1, @#177566
	SOB	R2, 1$
2$:	RETURN

;#####################################################################
;## WRSTRW
;## Need WRSTR
;## Need WRSPC
; Вывод строки в поле заданной ширины
; Вход: R0 = адрес строки, R1 = ширина. Портит: R0, R1, R2.
WRSTRW:
	MOV	R0, -(SP)
	CLR	R2
	BISB	(R0), R2	; длина строки
	SUB	R2, R1		; пробелов = ширина - длина
	CALL	WRSPC
	MOV	(SP)+, R0
	JMP	WRSTR

;#####################################################################
;## WRSTRI
;## Need WRSTR
; Вывод строковой константы; адрес строки -- слово сразу после CALL
; Портит: R0, R1, R2.
WRSTRI:
	MOV	@(SP), R0	; адрес строки из слова после CALL
	ADD	#2, (SP)	; возврат за это слово
	JMP	WRSTR

;#####################################################################
;## WRINT
;## Need WRCH
; Вывод целого числа -32768..32767
; Вход: R0 = число. Портит: R0, R1, R2, R4.
WRINT:
	MOV	R0, R4
	BPL	1$
	MOV	#'-, R0
	CALL	WRCH
	NEG	R4		; -32768 остаётся 100000: дальше без знака
1$:	CLR	R1		; флаг: значащая цифра уже была
	MOV	#10000., R2
	CALL	50$
	MOV	#1000., R2
	CALL	50$
	MOV	#100., R2
	CALL	50$
	MOV	#10., R2
	CALL	50$
	MOV	R4, R0		; последняя цифра печатается всегда
	ADD	#'0, R0
	JMP	WRCH
; Одна цифра: сколько раз R2 помещается в R4 (без знака)
50$:	MOV	#'0, R0
52$:	CMP	R4, R2
	BLO	54$
	SUB	R2, R4
	INC	R0
	INC	R1
	BR	52$
54$:	TST	R1		; ведущие нули не печатаем
	BEQ	56$
	JMP	WRCH
56$:	RETURN

;#####################################################################
;## WRINTW
;## Need WRINT
;## Need WRSPC
; Вывод целого числа в поле заданной ширины
; Вход: R0 = число, R1 = ширина. Портит: R0, R1, R2, R3, R4.
WRINTW:
	MOV	R0, -(SP)
	MOV	R0, R2
	MOV	#1, R3		; символов: минимум одна цифра
	TST	R2
	BPL	1$
	INC	R3		; знак минус
	NEG	R2
1$:	CMP	R2, #10.	; сравнения без знака: -32768 после NEG = 100000
	BLO	2$
	INC	R3
	CMP	R2, #100.
	BLO	2$
	INC	R3
	CMP	R2, #1000.
	BLO	2$
	INC	R3
	CMP	R2, #10000.
	BLO	2$
	INC	R3
2$:	SUB	R3, R1		; пробелов = ширина - символов
	CALL	WRSPC
	MOV	(SP)+, R0
	JMP	WRINT

;#####################################################################
;## WRBOOL
;## Need WRSTRW
; Вывод Boolean как TRUE или FALSE
; Вход: R0 = 0 или не 0, R1 = ширина (меньше длины -- без пробелов). Портит: R0, R1, R2.
WRBOOL:
	TST	R0
	BEQ	1$
	MOV	#WRBOO$, R0
	JMP	WRSTRW
1$:	MOV	#WRBOF$, R0
	JMP	WRSTRW
WRBOO$:	.BYTE	4, 'T, 'R, 'U, 'E
WRBOF$:	.BYTE	5, 'F, 'A, 'L, 'S, 'E
	.EVEN

;#####################################################################
;## WREOL
;## Need WRCH
; Перевод строки: CR LF
; Портит: R0.
WREOL:
	MOV	#15, R0
	CALL	WRCH
	MOV	#12, R0
	JMP	WRCH

;#####################################################################
;## RTERR
;## Need WRCH
;## Need WREOL
; Ошибка выполнения: печать "Run-time error NN, PC=nnnnnn", "Program aborted" и выход
; Вход: R0 = код ошибки (печатается в hex), (SP) = адрес возврата в программу
	.GLOBL	HALT
RTERR:
	MOV	R0, R3		; код ошибки
	MOV	(SP), R4	; адрес места в программе
	CALL	WREOL
	MOV	#RTERM$, R1	; "Run-time error "
	CALL	RTERS$
	MOV	R3, R0		; старший hex-разряд
	ASH	#-4, R0
	CALL	RTERH$
	MOV	R3, R0		; младший hex-разряд
	CALL	RTERH$
	MOV	#RTERP$, R1	; ", PC="
	CALL	RTERS$
	CLR	R0		; первая восьмеричная цифра -- бит 15
	ASL	R4
	ROL	R0
	ADD	#'0, R0
	CALL	WRCH
	MOV	#5, R2		; ещё пять цифр по три бита
1$:	CLR	R0
	ASL	R4
	ROL	R0
	ASL	R4
	ROL	R0
	ASL	R4
	ROL	R0
	ADD	#'0, R0
	CALL	WRCH
	SOB	R2, 1$
	CALL	WREOL
	MOV	#RTERA$, R1	; "Program aborted"
	CALL	RTERS$
	CALL	WREOL
	JMP	HALT
; Печать строки, завершённой нулём; R1 = адрес строки
RTERS$:	MOVB	(R1)+, R0
	BEQ	1$
	CALL	WRCH
	BR	RTERS$
1$:	RETURN
; Печать hex-разряда; R0 = значение, берутся младшие 4 бита
RTERH$:	BIC	#177760, R0
	ADD	#'0, R0
	CMP	R0, #'9
	BLOS	1$
	ADD	#7, R0		; 'A'..'F'
1$:	JMP	WRCH
RTERM$:	.ASCIZ	/Run-time error /
RTERP$:	.ASCIZ	/, PC=/
RTERA$:	.ASCIZ	/Program aborted/
	.EVEN

;#####################################################################
;## DIVZER
;## Need RTERR
; Деление на ноль, ошибка 02; вызывается сразу после DIV, когда установлен флаг V
DIVZER:
	MOV	#2, R0
	JMP	RTERR

;#####################################################################
;## RNGSCL
;## Need RTERR
; Проверка присваивания в поддиапазон или перечисление, ошибка 91
; Вход: R0 = значение; после CALL: .WORD нижняя, верхняя граница. Портит: R1.
RNGSCL:
	MOV	(SP), R1	; адрес границ
	CMP	R0, (R1)+
	BLT	1$
	CMP	R0, (R1)+
	BGT	1$
	MOV	R1, (SP)	; возврат за границы
	RETURN
1$:	MOV	#221, R0	; ошибка 91 (hex)
	JMP	RTERR

;#####################################################################
;## RNGCHK
;## Need RTERR
; Проверка индекса массива, ошибка 90
; Вход: R0 = индекс; после CALL: .WORD нижняя, верхняя граница. Портит: R1.
RNGCHK:
	MOV	(SP), R1	; адрес границ
	CMP	R0, (R1)+
	BLT	1$
	CMP	R0, (R1)+
	BGT	1$
	MOV	R1, (SP)	; возврат за границы
	RETURN
1$:	MOV	#220, R0	; ошибка 90 (hex)
	JMP	RTERR

;#####################################################################
;## ISHL
; Сдвиг влево на переменное число разрядов: R0 shl R1
; Вход: R0 = число, R1 = сдвиг. Выход: R0. Портит: R1.
ISHL:
	TST	R1
	BLE	2$
	CMP	R1, #16.
	BLT	1$
	CLR	R0		; сдвиг на 16 и больше
	RETURN
1$:	ASL	R0
	SOB	R1, 1$
2$:	RETURN

;#####################################################################
;## ISHR
; Логический сдвиг вправо на переменное число разрядов: R0 shr R1
; Вход: R0 = число, R1 = сдвиг. Выход: R0. Портит: R1.
ISHR:
	TST	R1
	BLE	2$
	CMP	R1, #16.
	BLT	1$
	CLR	R0		; сдвиг на 16 и больше
	RETURN
1$:	CLC
	ROR	R0
	SOB	R1, 1$
2$:	RETURN
