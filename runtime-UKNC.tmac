; Шаблон рантайма Pesto/11 для УКНЦ (RT-11)
; Интерфейсы блоков: docs/RUNTIME.md
; Блок: строка ;#### начинает блок, ;## ИМЯ задаёт имя, ;## Need ИМЯ -- зависимость.
; Через любой вызов сохраняются R5 и SP; R0-R4 могут портиться, если не сказано иное.
;

;#####################################################################
;## INIT
; Инициализация программы, вставляется в начало кода программы
	MTPS	#340		; запрет прерываний
	CLR	@#177560	; канал 0: без прерываний от клавиатуры
	MTPS	#0		; разрешение прерываний
	MOV	SP, INIT$S	; стек RT-11 для выхода
	MOV	#-2, R0		; .SETTOP: просим всю память
	EMT	354		; в R0 -- верх памяти программы
	BIC	#1, R0		; стек всегда на чётном адресе
	MOV	R0, SP		; стек программы растёт от верха памяти

;#####################################################################
;## TERM
; Завершение программы, вставляется в конец кода программы
HALT::
INIT$S = . + 2
	MOV	#776, SP	; восстанавливаем стек RT-11 (значение пишет INIT)
	EMT	350		; .EXIT

;#####################################################################
;## WRCH
; Вывод одного символа на консоль (канал 0)
; Вход: R0 = символ. Портит: ничего.
WRCH:
1$:	TSTB	@#177564	; канал 0 готов?
	BPL	1$		; нет -- ждём
	MOV	R0, @#177566	; передаём символ
	RETURN

;#####################################################################
;## WRSPC
;## Need WRCH
; Вывод пробелов
; Вход: R1 = количество, 0 и меньше -- ничего. Портит: R0, R1.
WRSPC:
	TST	R1
	BLE	2$
	MOV	#40, R0
1$:	CALL	WRCH
	SOB	R1, 1$
2$:	RETURN

;#####################################################################
;## WRCHW
;## Need WRSPC
; Вывод символа в поле заданной ширины
; Вход: R0 = символ, R1 = ширина. Портит: R0, R1.
WRCHW:
	MOV	R0, -(SP)
	DEC	R1		; пробелов = ширина - 1
	CALL	WRSPC
	MOV	(SP)+, R0
	JMP	WRCH

;#####################################################################
;## WRSTR
; Вывод строки
; Вход: R0 = адрес строки (байт длины и символы). Портит: R0, R1, R2.
WRSTR:
	CLR	R2
	BISB	(R0)+, R2	; длина строки
	BEQ	2$		; пустая строка
1$:	MOVB	(R0)+, R1
3$:	TSTB	@#177564	; канал 0 готов?
	BPL	3$
	MOV	R1, @#177566
	SOB	R2, 1$
2$:	RETURN

;#####################################################################
;## WRSTRW
;## Need WRSTR
;## Need WRSPC
; Вывод строки в поле заданной ширины
; Вход: R0 = адрес строки, R1 = ширина. Портит: R0, R1, R2.
WRSTRW:
	MOV	R0, -(SP)
	CLR	R2
	BISB	(R0), R2	; длина строки
	SUB	R2, R1		; пробелов = ширина - длина
	CALL	WRSPC
	MOV	(SP)+, R0
	JMP	WRSTR

;#####################################################################
;## WRSTRI
;## Need WRSTR
; Вывод строковой константы; адрес строки -- слово сразу после CALL
; Портит: R0, R1, R2.
WRSTRI:
	MOV	@(SP), R0	; адрес строки из слова после CALL
	ADD	#2, (SP)	; возврат за это слово
	JMP	WRSTR

;#####################################################################
;## WRINT
;## Need WRCH
; Вывод целого числа -32768..32767
; Вход: R0 = число. Портит: R0, R1, R2, R4.
WRINT:
	MOV	R0, R4
	BPL	1$
	MOV	#'-, R0
	CALL	WRCH
	NEG	R4		; -32768 остаётся 100000: дальше без знака
1$:	CLR	R1		; флаг: значащая цифра уже была
	MOV	#10000., R2
	CALL	50$
	MOV	#1000., R2
	CALL	50$
	MOV	#100., R2
	CALL	50$
	MOV	#10., R2
	CALL	50$
	MOV	R4, R0		; последняя цифра печатается всегда
	ADD	#'0, R0
	JMP	WRCH
; Одна цифра: сколько раз R2 помещается в R4 (без знака)
50$:	MOV	#'0, R0
52$:	CMP	R4, R2
	BLO	54$
	SUB	R2, R4
	INC	R0
	INC	R1
	BR	52$
54$:	TST	R1		; ведущие нули не печатаем
	BEQ	56$
	JMP	WRCH
56$:	RETURN

;#####################################################################
;## WRINTW
;## Need WRINT
;## Need WRSPC
; Вывод целого числа в поле заданной ширины
; Вход: R0 = число, R1 = ширина. Портит: R0, R1, R2, R3, R4.
WRINTW:
	MOV	R0, -(SP)
	MOV	R0, R2
	MOV	#1, R3		; символов: минимум одна цифра
	TST	R2
	BPL	1$
	INC	R3		; знак минус
	NEG	R2
1$:	CMP	R2, #10.	; сравнения без знака: -32768 после NEG = 100000
	BLO	2$
	INC	R3
	CMP	R2, #100.
	BLO	2$
	INC	R3
	CMP	R2, #1000.
	BLO	2$
	INC	R3
	CMP	R2, #10000.
	BLO	2$
	INC	R3
2$:	SUB	R3, R1		; пробелов = ширина - символов
	CALL	WRSPC
	MOV	(SP)+, R0
	JMP	WRINT

;#####################################################################
;## WRBOOL
;## Need WRSTRW
; Вывод Boolean как TRUE или FALSE
; Вход: R0 = 0 или не 0, R1 = ширина (меньше длины -- без пробелов). Портит: R0, R1, R2.
WRBOOL:
	TST	R0
	BEQ	1$
	MOV	#WRBOO$, R0
	JMP	WRSTRW
1$:	MOV	#WRBOF$, R0
	JMP	WRSTRW
WRBOO$:	.BYTE	4, 'T, 'R, 'U, 'E
WRBOF$:	.BYTE	5, 'F, 'A, 'L, 'S, 'E
	.EVEN

;#####################################################################
;## WREOL
;## Need WRCH
; Перевод строки: CR LF
; Портит: R0.
WREOL:
	MOV	#15, R0
	CALL	WRCH
	MOV	#12, R0
	JMP	WRCH

;#####################################################################
;## RTERR
;## Need WRCH
;## Need WREOL
; Ошибка выполнения: печать "Run-time error NN, PC=nnnnnn", "Program aborted" и выход
; Вход: R0 = код ошибки (печатается в hex), (SP) = адрес возврата в программу
	.GLOBL	HALT
RTERR:
	MOV	R0, R3		; код ошибки
	MOV	(SP), R4	; адрес места в программе
	CALL	WREOL
	MOV	#RTERM$, R1	; "Run-time error "
	CALL	RTERS$
	MOV	R3, R0		; старший hex-разряд
	ASH	#-4, R0
	CALL	RTERH$
	MOV	R3, R0		; младший hex-разряд
	CALL	RTERH$
	MOV	#RTERP$, R1	; ", PC="
	CALL	RTERS$
	CLR	R0		; первая восьмеричная цифра -- бит 15
	ASL	R4
	ROL	R0
	ADD	#'0, R0
	CALL	WRCH
	MOV	#5, R2		; ещё пять цифр по три бита
1$:	CLR	R0
	ASL	R4
	ROL	R0
	ASL	R4
	ROL	R0
	ASL	R4
	ROL	R0
	ADD	#'0, R0
	CALL	WRCH
	SOB	R2, 1$
	CALL	WREOL
	MOV	#RTERA$, R1	; "Program aborted"
	CALL	RTERS$
	CALL	WREOL
	JMP	HALT
; Печать строки, завершённой нулём; R1 = адрес строки
RTERS$:	MOVB	(R1)+, R0
	BEQ	1$
	CALL	WRCH
	BR	RTERS$
1$:	RETURN
; Печать hex-разряда; R0 = значение, берутся младшие 4 бита
RTERH$:	BIC	#177760, R0
	ADD	#'0, R0
	CMP	R0, #'9
	BLOS	1$
	ADD	#7, R0		; 'A'..'F'
1$:	JMP	WRCH
RTERM$:	.ASCIZ	/Run-time error /
RTERP$:	.ASCIZ	/, PC=/
RTERA$:	.ASCIZ	/Program aborted/
	.EVEN

;#####################################################################
;## DIVZER
;## Need RTERR
; Деление на ноль, ошибка 02; вызывается сразу после DIV, когда установлен флаг V
DIVZER:
	MOV	#2, R0
	JMP	RTERR

;#####################################################################
;## RNGSCL
;## Need RTERR
; Проверка присваивания в поддиапазон или перечисление, ошибка 91
; Вход: R0 = значение; после CALL: .WORD нижняя, верхняя граница. Портит: R1.
RNGSCL:
	MOV	(SP), R1	; адрес границ
	CMP	R0, (R1)+
	BLT	1$
	CMP	R0, (R1)+
	BGT	1$
	MOV	R1, (SP)	; возврат за границы
	RETURN
1$:	MOV	#221, R0	; ошибка 91 (hex)
	JMP	RTERR

;#####################################################################
;## RNGCHK
;## Need RTERR
; Проверка индекса массива, ошибка 90
; Вход: R0 = индекс; после CALL: .WORD нижняя, верхняя граница. Портит: R1.
RNGCHK:
	MOV	(SP), R1	; адрес границ
	CMP	R0, (R1)+
	BLT	1$
	CMP	R0, (R1)+
	BGT	1$
	MOV	R1, (SP)	; возврат за границы
	RETURN
1$:	MOV	#220, R0	; ошибка 90 (hex)
	JMP	RTERR

;#####################################################################
;## ISHL
; Сдвиг влево на переменное число разрядов: R0 shl R1
; Вход: R0 = число, R1 = сдвиг. Выход: R0. Портит: R1.
ISHL:
	TST	R1
	BLE	2$
	CMP	R1, #16.
	BLT	1$
	CLR	R0		; сдвиг на 16 и больше
	RETURN
1$:	ASL	R0
	SOB	R1, 1$
2$:	RETURN

;#####################################################################
;## ISHR
; Логический сдвиг вправо на переменное число разрядов: R0 shr R1
; Вход: R0 = число, R1 = сдвиг. Выход: R0. Портит: R1.
ISHR:
	TST	R1
	BLE	2$
	CMP	R1, #16.
	BLT	1$
	CLR	R0		; сдвиг на 16 и больше
	RETURN
1$:	CLC
	ROR	R0
	SOB	R1, 1$
2$:	RETURN

;#####################################################################
;## HEAPPT
; Переменные кучи (DESIGN 6.1). Куча растёт вверх от PEND, стек -- вниз от верха памяти.
HEAPPT:	.WORD	PEND		; HeapPtr: начало свободной памяти над кучей
FREELS:	.WORD	0		; список свободных блоков: +0 следующий блок, +2 размер
HEAPRS = 256.			; запас для стека: куча не подходит к SP ближе

;#####################################################################
;## NEW
;## Need HEAPPT
;## Need RTERR
; Выделение блока в куче (New, GetMem). Сначала ищется подходящий свободный блок,
; иначе блок берётся от HeapPtr. Ошибка FF, если куча подошла бы к стеку.
; Вход: R0 = размер в байтах. Выход: R0 = адрес блока. Портит: R1, R2.
NEW:
	INC	R0		; размер округляем вверх до чётного
	BIC	#1, R0
	CMP	R0, #4		; не меньше 4 байт: место для заголовка свободного блока
	BHIS	1$
	MOV	#4, R0
1$:	MOV	#FREELS, R1	; R1 = адрес ссылки на текущий свободный блок
2$:	MOV	(R1), R2	; R2 = текущий свободный блок
	BEQ	5$		; список кончился
	CMP	2(R2), R0
	BHIS	3$		; блок подходит
	MOV	R2, R1		; ссылка на следующий лежит в слове +0 блока
	BR	2$
3$:	MOV	2(R2), R1	; размер блока
	SUB	R0, R1		; остаток
	CMP	R1, #4
	BLO	4$
	MOV	R1, 2(R2)	; остаток остаётся в списке на прежнем месте
	ADD	R1, R2		; выделяем конец блока
	MOV	R2, R0
	RETURN
4$:	MOV	(R2), (R1)	; остаток мал: убираем блок из списка целиком
	MOV	R2, R0
	RETURN
5$:	MOV	HEAPPT, R1	; новый блок от HeapPtr
	ADD	R1, R0		; R0 = новый HeapPtr
	BCS	6$
	MOV	R0, R2
	ADD	#HEAPRS, R2
	BCS	6$
	CMP	R2, SP
	BHI	6$		; куча подошла бы к стеку
	MOV	R0, HEAPPT
	MOV	R1, R0		; адрес блока
	RETURN
6$:	MOV	#377, R0	; ошибка FF: куча столкнулась со стеком
	JMP	RTERR

;#####################################################################
;## DISPOS
;## Need HEAPPT
; Освобождение блока (Dispose, FreeMem). Верхний блок опускает HeapPtr,
; другой блок добавляется в начало списка свободных. Соседние блоки не сливаются.
; Вход: R0 = адрес блока, R1 = размер в байтах. Портит: R1, R2.
DISPOS:
	INC	R1		; размер так же, как в NEW
	BIC	#1, R1
	CMP	R1, #4
	BHIS	1$
	MOV	#4, R1
1$:	MOV	R0, R2
	ADD	R1, R2		; конец блока
	CMP	R2, HEAPPT
	BNE	2$
	MOV	R0, HEAPPT	; верхний блок: опускаем HeapPtr
	RETURN
2$:	MOV	FREELS, (R0)	; в начало списка свободных
	MOV	R1, 2(R0)
	MOV	R0, FREELS
	RETURN

;#####################################################################
;## RELEAS
;## Need HEAPPT
; Release: HeapPtr := R0, список свободных блоков очищается.
; Вход: R0 = значение, сохранённое Mark. Портит: ничего.
RELEAS:
	MOV	R0, HEAPPT
	CLR	FREELS
	RETURN

;#####################################################################
;## MEMAVL
;## Need HEAPPT
; MemAvail: свободная память между кучей и стеком (за вычетом запаса) плюс свободные блоки.
; Выход: R0 = число байт (больше 32767 -- отрицательное, как в TP3). Портит: R1.
MEMAVL:
	MOV	SP, R0
	SUB	#HEAPRS, R0
	SUB	HEAPPT, R0
	BCC	1$
	CLR	R0		; запас уже занят
1$:	MOV	#FREELS, R1
2$:	MOV	(R1), R1
	BEQ	3$
	ADD	2(R1), R0
	BR	2$
3$:	RETURN

;#####################################################################
;## MAXAVL
;## Need HEAPPT
; MaxAvail: самый большой блок, который может выделить New.
; Выход: R0 = число байт (больше 32767 -- отрицательное). Портит: R1.
MAXAVL:
	MOV	SP, R0
	SUB	#HEAPRS, R0
	SUB	HEAPPT, R0
	BCC	1$
	CLR	R0
1$:	MOV	#FREELS, R1
2$:	MOV	(R1), R1
	BEQ	3$
	CMP	2(R1), R0
	BLOS	2$
	MOV	2(R1), R0	; свободный блок больше
	BR	2$
3$:	RETURN

;#####################################################################
;## FILLCH
; FillChar: заполнение памяти байтом
; Вход: R0 = адрес, R1 = количество (<= 0 -- ничего), R2 = значение. Портит: R0, R1.
FILLCH:
	TST	R1
	BLE	2$
1$:	MOVB	R2, (R0)+
	SOB	R1, 1$
2$:	RETURN

;#####################################################################
;## MOVEM
; Move: копирование байтов с учётом перекрытия областей
; Вход: R0 = откуда, R1 = куда, R2 = количество (<= 0 -- ничего). Портит: R0, R1, R2.
MOVEM:
	TST	R2
	BLE	3$
	CMP	R1, R0
	BHI	2$		; назначение выше источника: копируем с конца
1$:	MOVB	(R0)+, (R1)+
	SOB	R2, 1$
	RETURN
2$:	ADD	R2, R0
	ADD	R2, R1
4$:	MOVB	-(R0), -(R1)
	SOB	R2, 4$
3$:	RETURN
